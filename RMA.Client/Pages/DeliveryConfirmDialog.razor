@using RMA.Shared.DTOs
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using System.IO
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column gap-3">
            <MudText Typo="Typo.h6">Mã đơn: @Order.OrderCode</MudText>
            <MudText Typo="Typo.subtitle1">Khách hàng: @Order.CustomerName</MudText>
            
            @if (!string.IsNullOrWhiteSpace(Order.SalesNote))
            {
                <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Left"
                          Style="color: #1a1a1a; font-weight: 600;">@Order.SalesNote</MudAlert>
            }

            <MudDivider />

            @foreach (var detail in Order.Details)
            {
                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        @detail.ModelName - Số lượng: @detail.Quantity
                    </MudText>
                    
                    @if (!detail.IsSerialRequired)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-1">💡 Để trống nếu sản phẩm không có S/N</MudText>
                    }

                    @{
                        if (!_scannedSerials.ContainsKey(detail.ModelId))
                        {
                            _scannedSerials[detail.ModelId] = new List<string>(new string[detail.Quantity]);
                        }
                    }

                    <MudGrid>
                        @for (int i = 0; i < detail.Quantity; i++)
                        {
                            int currentIndex = i;
                            var refKey = $"{detail.ModelId}_{currentIndex}";
                            <MudItem xs="12" sm="6" md="4">
                                <InputFile id="@($"ocr_{detail.ModelId}_{currentIndex}")" OnChange="@(e => UploadImageForOcr(e, detail.ModelId, currentIndex))" accept="image/*" style="display:none;" />
                                <MudTextField T="string"
                                               @ref="_serialRefs[refKey]"
                                               Value="@_scannedSerials[detail.ModelId][currentIndex]"
                                               ValueChanged="@(val => OnSerialChanged(val, detail.ModelId, currentIndex))"
                                               Label="@(IsScanning(detail.ModelId, currentIndex) ? $"S/N {currentIndex + 1} (Đang quét...)" : $"S/N {currentIndex + 1}")"
                                               Placeholder="@(!detail.IsSerialRequired ? "Không bắt buộc" : "")"
                                               Adornment="Adornment.End"
                                               AdornmentIcon="@(IsScanning(detail.ModelId, currentIndex) ? Icons.Material.Filled.Sync : Icons.Material.Filled.QrCodeScanner)"
                                               OnAdornmentClick="@(() => TriggerOcrScan(detail.ModelId, currentIndex))"
                                               OnKeyUp="@(e => HandleKeyUp(e, detail.ModelId, currentIndex))"
                                               Immediate="true"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Disabled="@IsScanning(detail.ModelId, currentIndex)" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Confirm" Disabled="@_isSubmitting">Xác nhận Giao Hàng & Kích hoạt BH</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public SalesOrderDto Order { get; set; } = new();

    private Dictionary<string, MudTextField<string>> _serialRefs = new();
    private Dictionary<string, List<string>> _scannedSerials = new();
    
    private bool _ocrScanning = false;
    private string _scanningModelId = string.Empty;
    private int _scanningIndex = -1;
    private bool _isSubmitting = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Initialize the dictionary for ALL products (not just IsSerialRequired)
        foreach (var detail in Order.Details)
        {
            var list = new List<string>(detail.Quantity);
            for (int i = 0; i < detail.Quantity; i++) list.Add(string.Empty);
            _scannedSerials[detail.ModelId] = list;
        }
    }

    private void OnSerialChanged(string val, string modelId, int index)
    {
        _scannedSerials[modelId][index] = val ?? string.Empty;
        StateHasChanged();
    }

    private bool IsScanning(string modelId, int index)
    {
        return _ocrScanning && _scanningModelId == modelId && _scanningIndex == index;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e, string modelId, int index)
    {
        if (e.Key == "Enter")
        {
            await FocusNextInput(modelId, index);
        }
    }

    private async Task TriggerOcrScan(string modelId, int index)
    {
        await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('ocr_{modelId}_{index}')?.click()");
    }

    private async Task UploadImageForOcr(InputFileChangeEventArgs e, string modelId, int index)
    {
        var file = e.File;
        if (file == null) return;
        
        _ocrScanning = true;
        _scanningModelId = modelId;
        _scanningIndex = index;
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10485760).CopyToAsync(ms);
            var buffer = ms.ToArray();
            var base64 = Convert.ToBase64String(buffer);

            var response = await Http.PostAsJsonAsync("api/ocr/scan", new OcrRequestDto { Base64Image = base64 });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OcrResponseDto>();
                if (result != null && !string.IsNullOrEmpty(result.SerialNumber))
                {
                    _scannedSerials[modelId][index] = result.SerialNumber;
                    Snackbar.Add($"✅ OCR thành công! S/N: {result.SerialNumber}", Severity.Success);
                    await FocusNextInput(modelId, index);
                }
                else
                {
                    Snackbar.Add("Không nhận diện được Serial Number từ ảnh.", Severity.Warning);
                }
            }
            else
            {
                string errorMsg = "Lỗi khi gọi API OCR.";
                try
                {
                    var errorObj = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                    if (errorObj != null && errorObj.TryGetValue("message", out var msg))
                    {
                        errorMsg = msg;
                    }
                }
                catch
                {
                    // Fallback to default message if error response is not JSON
                }
                Snackbar.Add(errorMsg, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _ocrScanning = false;
            _scanningModelId = string.Empty;
            _scanningIndex = -1;
            StateHasChanged();
        }
    }

    private async Task FocusNextInput(string currentModelId, int currentIndex)
    {
        var detail = Order.Details.First(d => d.ModelId == currentModelId);
        
        // Cùng Model, chuyển sang index tiếp theo
        if (currentIndex + 1 < detail.Quantity)
        {
            string nextKey = $"{currentModelId}_{currentIndex + 1}";
            if (_serialRefs.TryGetValue(nextKey, out var nextField) && nextField != null)
            {
                await nextField.FocusAsync();
            }
        }
        else
        {
            // Chuyển sang Model tiếp theo có yêu cầu quét Serial
            var requiredDetails = Order.Details.Where(d => d.IsSerialRequired).ToList();
            int modelIndex = requiredDetails.FindIndex(d => d.ModelId == currentModelId);
            
            if (modelIndex >= 0 && modelIndex + 1 < requiredDetails.Count)
            {
                string nextModelId = requiredDetails[modelIndex + 1].ModelId;
                string nextKey = $"{nextModelId}_0";
                if (_serialRefs.TryGetValue(nextKey, out var nextField) && nextField != null)
                {
                    await nextField.FocusAsync();
                }
            }
        }
    }

    private async Task Confirm()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var dto = new ConfirmDeliveryDto
            {
                OrderId = Order.Id,
                SerialNumbersByModel = _scannedSerials.ToDictionary(kvp => kvp.Key, kvp => kvp.Value)
            };

            var response = await Http.PostAsJsonAsync("api/salesorders/confirm-delivery", dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Giao hàng & kích hoạt BH thành công!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Lỗi từ máy chủ: {error}", Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Lỗi kết nối máy chủ, vui lòng thử lại. ({ex.Message})", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Đã xảy ra lỗi không mong muốn: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
