    async Task UploadImageForOcr(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        _ocrScanning = true;
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10485760).CopyToAsync(ms);
            var buffer = ms.ToArray();
            var base64 = Convert.ToBase64String(buffer);

            var response = await Http.PostAsJsonAsync("api/ocr/scan", new OcrRequestDto { Base64Image = base64 });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OcrResponseDto>();
                if (result != null && !string.IsNullOrEmpty(result.SerialNumber))
                {
                    _searchSerial = result.SerialNumber;
                    Snackbar.Add($"✅ OCR thành công! S/N: {_searchSerial}", Severity.Success);
                    await SearchSerialNumber();
                }
                else
                {
                    Snackbar.Add("Không nhận diện được Serial Number từ ảnh.", Severity.Warning);
                }
            }
            else
            {
                string errorMsg = "Lỗi khi gọi API OCR.";
                try
                {
                    var errorObj = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                    if (errorObj != null && errorObj.TryGetValue("message", out var msg))
                    {
                        errorMsg = msg;
                    }
                }
                catch
                {
                    // Fallback to default message if error response is not JSON
                }
                Snackbar.Add(errorMsg, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _ocrScanning = false;
            StateHasChanged();
        }
    }

    async Task SearchSerialNumber()
    {
        if (string.IsNullOrWhiteSpace(_searchSerial))
        {
            Snackbar.Add("Vui lòng nhập Serial Number!", Severity.Warning);
            return;
        }

        _searchingSerial = true;
        _searchedDevice = null;
        _deviceNotFound = false;
        _showAddDevice = false;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"api/devices/by-serial/{Uri.EscapeDataString(_searchSerial.Trim())}");
            if (response.IsSuccessStatusCode)
            {
                var device = await response.Content.ReadFromJsonAsync<DeviceDto>();
                if (device != null)
                {
                    _searchedDevice = device;
                    Ticket.DeviceId = device.Id;
                    Ticket.DeviceSerialNumber = device.SerialNumber;
                    Ticket.DeviceModelName = device.ModelName;
                    Ticket.CustomerId = device.CustomerId;
                    Ticket.DeviceWarrantyExpiry = device.WarrantyExpiry;
                    CalculateWarrantyStatus(device.WarrantyExpiry);
                    
                    _filteredDevices = _allDevices.Where(d => d.CustomerId == Ticket.CustomerId).ToList();
                    UpdateBrand();
                    Snackbar.Add($"✅ Tìm thấy thiết bị S/N: {device.SerialNumber}", Severity.Success);
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _deviceNotFound = true;
                Snackbar.Add("Không tìm thấy S/N trong hệ thống.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("Có lỗi xảy ra khi tìm kiếm thiết bị.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi kết nối: {ex.Message}", Severity.Error);
        }
        finally
        {
            _searchingSerial = false;
            StateHasChanged();
        }
    }

    void CalculateWarrantyStatus(DateTime? expiry)
    {
        if (!expiry.HasValue)
        {
            _warrantyStatus = "Không rõ hạn bảo hành";
            _warrantyStatusColor = "grey";
            _warrantyActive = false;
            Ticket.ServiceMode = "Sửa chữa";
            return;
        }

        var today = DateTime.Today;
        var expiryDate = expiry.Value.Date;

        if (expiryDate < today)
        {
            _warrantyStatus = "Hết bảo hành";
            _warrantyStatusColor = "error";
            _warrantyActive = false;
            Ticket.ServiceMode = "Sửa chữa";
        }
        else if ((expiryDate - today).TotalDays <= 7)
        {
            _warrantyStatus = "Sắp hết bảo hành (<= 7 ngày)";
            _warrantyStatusColor = "warning";
            _warrantyActive = true;
            Ticket.ServiceMode = "Bảo hành";
        }
        else
        {
            _warrantyStatus = "Còn bảo hành";
            _warrantyStatusColor = "success";
            _warrantyActive = true;
            Ticket.ServiceMode = "Bảo hành";
        }
    }

    void ClearSearchedDevice()
    {
        _searchedDevice = null;
        Ticket.DeviceId = "";
        Ticket.DeviceSerialNumber = "";
        Ticket.DeviceModelName = "";
        StateHasChanged();
    }

    void PrepareAddDevice()
    {
        _showAddDevice = true;
        _newDeviceSerial = _searchSerial.Trim();
        _newDeviceModelId = "";
        _newDevicePurchaseDate = DateTime.Today;
        _newDeviceWarrantyExpiry = DateTime.Today.AddYears(1);
        _deviceNotFound = false;
        StateHasChanged();
    }

    void CancelAddDevice()
    {
        _showAddDevice = false;
        _deviceNotFound = true;
        StateHasChanged();
    }

