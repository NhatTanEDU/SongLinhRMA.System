    private void OnDeviceSelected(string deviceId)
    {
        Ticket.DeviceId = deviceId;
        var dev = _filteredDevices.FirstOrDefault(d => d.Id == deviceId);
        if (dev != null)
        {
            Ticket.DeviceSerialNumber = dev.SerialNumber;
            Ticket.DeviceModelName = dev.ModelName;
        }
        CheckApcWarranty();
    }

    private void CheckApcWarranty()
    {
        isApcDevice = false;
        _apcExpiryDate = null;
        
        var dev = _filteredDevices.FirstOrDefault(d => d.Id == Ticket.DeviceId);
        if (dev == null) return;

        bool isApc = (!string.IsNullOrEmpty(dev.ModelName) && dev.ModelName.Contains("APC", StringComparison.OrdinalIgnoreCase)) ||
                     (!string.IsNullOrEmpty(dev.Brand) && dev.Brand.Contains("APC", StringComparison.OrdinalIgnoreCase));

        if (!isApc) return;

        string sn = dev.SerialNumber ?? "";
        if (sn.Length >= 6 && 
            char.IsDigit(sn[2]) && char.IsDigit(sn[3]) && 
            char.IsDigit(sn[4]) && char.IsDigit(sn[5]))
        {
            if (int.TryParse(sn.Substring(2, 2), out int yearVal) &&
                int.TryParse(sn.Substring(4, 2), out int weekVal))
            {
                if (weekVal >= 1 && weekVal <= 53)
                {
                    int fullYear = 2000 + yearVal;
                    if (yearVal > 80)
                    {
                        fullYear = 1900 + yearVal;
                    }

                    try
                    {
                        DateTime jan1 = new DateTime(fullYear, 1, 1);
                        DateTime mfgDate = jan1.AddDays((weekVal - 1) * 7);
                        DateTime expiryDate = mfgDate.AddMonths(24);
                        
                        _apcExpiryDate = expiryDate;
                        _warrantyActive = expiryDate >= DateTime.Today;
                        isApcDevice = true;
                    }
                    catch
                    {
                        // Ignore date math errors
                    }
                }
            }
        }
    }

    private async Task LookupWarranty()
    {
        var sn = Ticket.DeviceSerialNumber;
        if (string.IsNullOrEmpty(sn)) return;

        // Copy S/N vào clipboard
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", sn);

        // Lấy URL tra cứu: ưu tiên VendorWarrantyLink trong DB, fallback về switch theo tên hãng
        string url = !string.IsNullOrEmpty(Ticket.VendorWarrantyLink)
            ? Ticket.VendorWarrantyLink
            : GetFallbackWarrantyUrl();

        // Mở tab mới
        await JsRuntime.InvokeVoidAsync("open", url, "_blank");

        Snackbar.Add($"✅ Đã copy S/N: <b>{sn}</b>. Đang chuyển hướng đến trang bảo hành hãng...", Severity.Info);
    }

    private string GetFallbackWarrantyUrl()
    {
        var vendorName = (Ticket.VendorName ?? string.Empty).ToLower();
        return vendorName switch
        {
            var v when v.Contains("dell")  => $"https://www.dell.com/support/home/vi-vn?app=warranty&SerialNumber={Ticket.DeviceSerialNumber}",
            var v when v.Contains("apple") => "https://checkcoverage.apple.com/vn/vi/",
            var v when v.Contains("asus")  => "https://www.asus.com/vn/support/warranty-status-inquiry/",
            var v when v.Contains("hp")    => "https://support.hp.com/vn-vi/check-warranty",
            var v when v.Contains("apc")   => "https://www.apc.com/vi/vi/support/",
            _ => $"https://www.google.com/search?q=tra+cuu+bao+hanh+{Uri.EscapeDataString(Ticket.VendorName ?? "")}"
        };
    }

    void ToggleAcc(string acc)
    {
        if (_selectedAcc.Contains(acc)) _selectedAcc.Remove(acc);
        else _selectedAcc.Add(acc);
    }

    void AddCustomAcc()
    {
        if (!string.IsNullOrWhiteSpace(_customAcc))
        {
            var t = _customAcc.Trim();
            if (!_accessories.Contains(t)) _accessories.Add(t);
            if (!_selectedAcc.Contains(t)) _selectedAcc.Add(t);
            _customAcc = "";
        }
    }

    private async Task OnFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        if (files == null || !files.Any()) return;
        _uploading = true;
        StateHasChanged();

        foreach (var file in files)
        {
            if (file.Size > 5 * 1024 * 1024)
            {
                Snackbar.Add($"File {file.Name} vượt quá giới hạn 5MB!", Severity.Warning);
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());

                Ticket.Attachments.Add(new AttachmentDto
                {
                    FileName = file.Name,
                    Base64Data = base64,
                    FileType = file.Name.Contains("serial", StringComparison.OrdinalIgnoreCase) || file.Name.Contains("sn", StringComparison.OrdinalIgnoreCase)
                        ? "SN_PHOTO"
                        : "CONDITION_PHOTO",
                    UploadedAt = DateTime.UtcNow
                });
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi khi tải ảnh {file.Name}: {ex.Message}", Severity.Error);
            }
        }

        _uploading = false;
        StateHasChanged();
    }

    private void RemoveAttachment(AttachmentDto att)
    {
        Ticket.Attachments.Remove(att);
    }

    private string GetCleanStaffNote(string? staffNote)
    {
        if (string.IsNullOrEmpty(staffNote)) return "";
        if (staffNote.StartsWith("[Vị trí:", StringComparison.OrdinalIgnoreCase))
        {
            var newlineIndex = staffNote.IndexOf('\n');
            if (newlineIndex != -1)
            {
                return staffNote.Substring(newlineIndex + 1);
            }
            return "";
        }
        return staffNote;
    }

    private async Task UpdateDevice()
    {
        isSaving = true;
        
        // Gắn lại StatusName theo Id vừa chọn (để update local grid cho đẹp)
        var selectedStatus = _statuses.FirstOrDefault(s => s.Id == Ticket.StatusId);
        if (selectedStatus != null)
        {
            Ticket.StatusName = selectedStatus.StatusName;
            Ticket.StatusColorCode = selectedStatus.ColorCode;

            if (Ticket.StatusName.Equals("Closed", StringComparison.OrdinalIgnoreCase))
            {
                Ticket.WarningColor = null;
                Ticket.IsUrgent = false;
            }
        }

        // Cập nhật lại thông tin Thiết bị dựa trên Id mới (nếu được thay đổi)
        var selectedDev = _filteredDevices.FirstOrDefault(d => d.Id == Ticket.DeviceId);
        if (selectedDev != null)
        {
            Ticket.DeviceSerialNumber = selectedDev.SerialNumber;
            Ticket.DeviceModelName = selectedDev.ModelName;
        }

        // Cập nhật lại StaffNote kèm metadata vị trí, bảo hành, phụ kiện
        var cleanNote = GetCleanStaffNote(Ticket.StaffNote);
        var accStr = _selectedAcc.Any() ? string.Join(", ", _selectedAcc) : "Không có";
        var bh     = _warrantyActive ? "Còn BH" : "Hết BH";
        var meta   = $"[Vị trí: {_location}] [BH: {bh}] [Phụ kiện: {accStr}]";
        Ticket.StaffNote = string.IsNullOrWhiteSpace(cleanNote)
            ? meta
            : $"{meta}\n{cleanNote}";

        // Đồng bộ local checklists cho giao diện cập nhật ngay lập tức
        Ticket.Checklists = _selectedAcc.Select(a => new ChecklistDto { ItemName = a, IsChecked = true }).ToList();

        var success = await TicketService.UpdateRmaTicketAsync(Ticket.Id, Ticket);
        
        isSaving = false;

        if (success)
        {
            Snackbar.Add("Đã cập nhật thay đổi thành công!", Severity.Success);
            isEditing = false;
            StateHasChanged();
            if (OnTicketUpdated.HasDelegate)
            {
                await OnTicketUpdated.InvokeAsync(Ticket);
            }
        }
        else
        {
            Snackbar.Add("Có lỗi xảy ra khi cập nhật.", Severity.Error);
        }
    }

