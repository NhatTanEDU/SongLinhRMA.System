@using RMA.Shared.DTOs
@using RMA.Shared.Helpers

<MudCard Elevation="4" Class="mb-4" Style="border-left: 6px solid var(--mud-palette-primary); background: #fafbff; border-radius: 12px;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: var(--mud-palette-primary);">
                📦 @Summary.Brand - @Summary.ModelName
            </MudText>
            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">S/N: @Summary.SerialNumber</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (!Summary.WarrantyExpiry.HasValue)
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Filled" Style="margin-top: 8px; margin-right: 16px;">
                    Không có thông tin bảo hành
                </MudChip>
            }
            else if (DaysRemaining < 0)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Style="margin-top: 8px; margin-right: 16px;">
                    Hết bảo hành 🔴 (Quá hạn @(Math.Abs(DaysRemaining)) ngày)
                </MudChip>
            }
            else if (DaysRemaining < 5)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Style="margin-top: 8px; margin-right: 16px;">
                    Sắp hết hạn bảo hành 🟡 (Còn @DaysRemaining ngày)
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Style="margin-top: 8px; margin-right: 16px;">
                    Còn bảo hành 🟢 (Còn @DaysRemaining ngày)
                </MudChip>
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Style="padding-top: 0;">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-1 mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Default" />
                    <MudText Typo="Typo.body2"><b>Khách hàng:</b> @Summary.CustomerName</MudText>
                </div>
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Color="Color.Default" />
                    <MudText Typo="Typo.body2">
                        <b>Đơn hàng bán:</b> @(string.IsNullOrEmpty(Summary.OrderCode) ? "Không xác định" : $"#{Summary.OrderCode}") 
                        @(Summary.DeliveryDate.HasValue ? $"(Giao ngày: {Summary.DeliveryDate.Value.ToLocalTime().ToString("dd/MM/yyyy")})" : "")
                    </MudText>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-1 mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Default" />
                    <MudText Typo="Typo.body2"><b>Vị trí hiện tại:</b> 📍 @(string.IsNullOrEmpty(Summary.CurrentLocationName) ? "Nội bộ" : Summary.CurrentLocationName)</MudText>
                </div>
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
                    <MudText Typo="Typo.body2"><b>Trạng thái:</b> @TicketStatusHelper.GetDisplayName(Summary.CurrentStatus)</MudText>
                </div>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public DeviceSummaryDto Summary { get; set; } = new();

    private int DaysRemaining => Summary.WarrantyExpiry.HasValue 
        ? (Summary.WarrantyExpiry.Value.ToLocalTime().Date - DateTime.Now.Date).Days
        : 0;
}
