@using RMA.Shared.DTOs
@using RMA.Shared.Enums
@using RMA.Shared.Helpers
@using RMA.Client.Components
@inject RMA.Client.Services.CustomerService CustomerService
@inject RMA.Client.Services.DeviceService DeviceService
@inject RMA.Client.Services.IRmaTicketService TicketService
@inject RMA.Client.Services.ReferenceDataService ReferenceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<style>
    .rma-section {
        border: 1px solid rgba(99,102,241,0.18);
        border-radius: 12px;
        padding: 16px 20px 20px 20px;
        margin-bottom: 18px;
        background: linear-gradient(135deg, rgba(255,255,255,0.85) 0%, rgba(249,250,255,0.9) 100%);
        box-shadow: 0 2px 10px rgba(99,102,241,0.06);
        transition: box-shadow 0.2s;
    }
    .rma-section:hover { box-shadow: 0 4px 18px rgba(99,102,241,0.13); }
    .rma-section-header {
        display: flex; align-items: center; gap: 8px;
        font-weight: 700; font-size: 0.85rem; letter-spacing: 0.04em;
        color: #5b5fc7; text-transform: uppercase;
        border-bottom: 2px solid rgba(99,102,241,0.15);
        padding-bottom: 8px; margin-bottom: 14px;
    }
    .ocr-box {
        border: 2px dashed #64b5f6;
        border-radius: 8px; padding: 12px;
        background: rgba(33,150,243,0.04);
        text-align: center; position: relative; overflow: hidden;
    }
    .scan-line {
        position: absolute; left: 0; width: 100%; height: 3px;
        background: linear-gradient(90deg, transparent, #2196f3, transparent);
        animation: scanMove 1.4s linear infinite;
        box-shadow: 0 0 8px #2196f3;
    }
    @@keyframes scanMove { 0%{top:0} 50%{top:100%} 100%{top:0} }
    .acc-chip {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 20px; margin: 3px;
        font-size: 0.8rem; cursor: pointer; transition: all 0.2s;
        border: 1.5px solid #c5c6f7; background: #fff; color: #5b5fc7;
        user-select: none;
    }
    .acc-chip.selected {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff; border-color: transparent;
        box-shadow: 0 2px 8px rgba(102,126,234,0.35);
    }
</style>

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudGrid Spacing="0">

                <!-- ====== KHỐI 1: NHẬP VÀ TRA CỨU S/N TOÀN CỤC ====== -->
                <MudItem xs="12">
                    <div class="rma-section">
                        <div class="rma-section-header">
                            <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Style="font-size:1.1rem;" />
                            1. Tra Cứu Số Serial (S/N) Thiết Bị
                        </div>
                        <MudGrid>
                            <!-- Nhập Serial Number -->
                            <MudItem xs="12" sm="8" md="9">
                                <MudTextField T="string"
                                              @ref="_snInputRef"
                                              @bind-Value="_searchSerialNumber"
                                              Label="Nhập số Serial Number (S/N) *"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Disabled="@(!string.IsNullOrEmpty(Ticket.Id) || _isSearching)"
                                              OnKeyDown="@HandleKeyDown"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.QrCode"
                                              Immediate="true"
                                              HelperText="Nhập tay S/N hoặc sử dụng tính năng Quét OCR bên dưới" />
                            </MudItem>
                            <!-- Nút Tra cứu -->
                            <MudItem xs="12" sm="4" md="3">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Search"
                                           OnClick="LookupDevice"
                                           Disabled="@(string.IsNullOrWhiteSpace(_searchSerialNumber) || _isSearching || !string.IsNullOrEmpty(Ticket.Id))"
                                           FullWidth="true"
                                           Style="height: 40px; margin-bottom: 22px;">
                                    @(_isSearching ? "Đang tìm..." : "Tra cứu")
                                </MudButton>
                            </MudItem>

                            <!-- OCR Scan Button (Chỉ hiện khi tạo mới) -->
                            @if (string.IsNullOrEmpty(Ticket.Id))
                            {
                                <MudItem xs="12">
                                    <InputFile id="ocrInput" OnChange="UploadImageForOcr" accept="image/*" style="display:none;" />
                                    @if (!_ocrScanning)
                                    {
                                        <div class="w-100">
                                            <MudButton HtmlTag="label" for="ocrInput" Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                                                       StartIcon="@Icons.Material.Filled.PhotoCamera" Disabled="@_isSearching">
                                                📷 Tải Ảnh Chụp S/N Vật Lý Để Quét OCR
                                            </MudButton>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ocr-box">
                                            <div class="scan-line"></div>
                                            <MudProgressLinear Color="Color.Info" Indeterminate="true" Class="mb-2" />
                                            <MudText Typo="Typo.caption" Color="Color.Info">
                                                <b>🔍 Đang nhận diện mã vạch và trích xuất Serial Number...</b>
                                            </MudText>
                                        </div>
                                    }
                                </MudItem>
                            }
                        </MudGrid>

                        <!-- Banner Cảnh báo Ticket đang mở -->
                        @if (CurrentDevice?.ActiveTicket != null)
                        {
                            <MudAlert Severity="Severity.Warning" Class="rounded-lg mt-3" Style="border-left: 6px solid var(--mud-palette-warning);">
                                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                    <MudText Typo="Typo.body2">
                                        ⚠️ <strong>Thiết bị đang có ca xử lý chưa đóng!</strong> 
                                        Mã Ticket: <strong>@CurrentDevice.ActiveTicket.TicketId</strong> 
                                        | Trạng thái: <strong>@TicketStatusHelper.GetDisplayName(CurrentDevice.ActiveTicket.Status)</strong>
                                        | Vị trí: <strong>@CurrentDevice.ActiveTicket.LocationName</strong>
                                        @(CurrentDevice.ActiveTicket.SentDate.HasValue ? $"| Ngày gửi: {CurrentDevice.ActiveTicket.SentDate.Value.ToLocalTime().ToString("dd/MM/yyyy")}" : "")
                                    </MudText>
                                    <div class="d-flex align-center gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="@(() => OpenExistingTicket(CurrentDevice.ActiveTicket.TicketId))">
                                            Mở xem Ticket cũ
                                        </MudButton>
                                        @if (_isAdmin)
                                        {
                                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Ghi đè (Admin)</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Filled">Bị khóa (Chờ xử lý xong)</MudChip>
                                        }
                                    </div>
                                </div>
                            </MudAlert>
                        }

                        <!-- Lịch sử Ticket của thiết bị -->
                        @if (CurrentDevice?.TicketHistory != null && CurrentDevice.TicketHistory.Any())
                        {
                            <MudCard Elevation="0" Class="mt-3 pa-2 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-background-grey);">
                                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="mr-1" Style="vertical-align: text-bottom;"/>
                                    Lịch sử bảo hành của thiết bị này (@CurrentDevice.TicketHistory.Count ca)
                                </MudText>
                                <MudTable Items="@CurrentDevice.TicketHistory" Dense="true" Hover="true" Elevation="0" Class="rounded-lg">
                                    <HeaderContent>
                                        <MudTh>Mã Ticket</MudTh>
                                        <MudTh>Ngày nhận</MudTh>
                                        <MudTh>Trạng thái</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="hist">
                                        <MudTd DataLabel="Mã Ticket">
                                            <strong>@hist.TicketCode</strong>
                                            @if (hist.TicketId == CurrentDevice.ActiveTicket?.TicketId)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2 px-1" Style="height: 18px; font-size: 10px;">Đang mở</MudChip>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Ngày nhận">@(hist.ReceivedDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</MudTd>
                                        <MudTd DataLabel="Trạng thái">
                                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(hist.Status)">
                                                @TicketStatusHelper.GetDisplayName(hist.Status)
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="" Style="text-align: right">
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenExistingTicket(hist.TicketId))">
                                                Xem chi tiết
                                            </MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudCard>
                        }

                        <!-- Thông báo nếu không tìm thấy S/N và hiển thị form tạo thiết bị nhanh -->
                        @if (_deviceNotFound && string.IsNullOrEmpty(Ticket.Id))
                        {
                            <MudAlert Severity="Severity.Warning" Class="rounded-lg mt-3">
                                ⚠️ Thiết bị S/N <strong>@_searchSerialNumber</strong> chưa được đăng ký trong hệ thống!
                            </MudAlert>

                            <MudCard Elevation="2" Class="mt-3 pa-3" Style="border-left: 4px solid var(--mud-palette-info);">
                                <MudText Typo="Typo.subtitle2" Color="Color.Info"><b>+ Đăng Ký Thiết Bị Mới Nhanh</b></MudText>
                                <MudGrid Spacing="2" Class="mt-1">
                                    <!-- Khách hàng -->
                                    <MudItem xs="12" md="6">
                                        <div class="d-flex align-end gap-2">
                                            <MudSelect T="string" Label="Khách hàng sở hữu *" @bind-Value="_newDeviceCustomerId"
                                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Style="margin-top: 0;">
                                                @foreach (var c in _customers)
                                                {
                                                    <MudSelectItem Value="@c.Id">@c.Name @(c.Phone != null ? $"({c.Phone})" : "")</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudTooltip Text="Thêm khách hàng mới">
                                                <MudIconButton Icon="@Icons.Material.Filled.PersonAdd"
                                                               Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                                                               OnClick="OpenAddCustomerDialog" Style="height: 40px; width: 40px;" />
                                            </MudTooltip>
                                        </div>
                                    </MudItem>

                                    <!-- Model thiết bị -->
                                    <MudItem xs="12" md="6">
                                        <div class="d-flex align-end gap-2">
                                            <MudSelect T="string" Label="Model dòng máy *" @bind-Value="_newDeviceModelId"
                                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Style="margin-top: 0;">
                                                @foreach (var m in _models)
                                                {
                                                    <MudSelectItem Value="@m.Id">@m.ModelName (@m.Brand)</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudTooltip Text="Thêm Model mới">
                                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                               Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                                                               OnClick="OpenAddModelDialog" Style="height: 40px; width: 40px;" />
                                            </MudTooltip>
                                        </div>
                                    </MudItem>
                                </MudGrid>
                                <div class="d-flex justify-end gap-2 mt-3">
                                    <MudButton Size="Size.Small" OnClick="@(() => _deviceNotFound = false)">Hủy</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" OnClick="SaveDevice" Disabled="@_savingNewDevice">
                                        @(_savingNewDevice ? "Đang lưu..." : "Lưu thiết bị & Tự động điền")
                                    </MudButton>
                                </div>
                            </MudCard>
                        }
                    </div>
                </MudItem>

                @if (CurrentDevice != null)
                {
                    <!-- ====== KHỐI 2: THÔNG TIN THIẾT BỊ VÀ BẢO HÀNH (Chỉ xem) ====== -->
                    <MudItem xs="12">
                        <DeviceSummaryCard Summary="CurrentDevice" />
                    </MudItem>

                    <!-- ====== KHỐI 3: THÔNG TIN LỖI VÀ BÀN GIAO THỰC TẾ (Kỹ thuật viên nhập) ====== -->
                    <MudItem xs="12">
                        <div class="rma-section">
                            <div class="rma-section-header">
                                <MudIcon Icon="@Icons.Material.Filled.EditNote" Style="font-size:1.1rem;" />
                                2. Thông Tin Lỗi & Tiếp Nhận Ca Hiện Tại
                            </div>
                            <MudGrid Spacing="3">
                                <!-- Người sử dụng cuối / Phòng ban -->
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="Ticket.EndUserName"
                                                  Label="Người dùng cuối / Phòng ban (Tùy chọn)"
                                                  Placeholder="VD: Nguyễn Thành Tâm P.TK, Trần Văn B P.KT..."
                                                  Variant="Variant.Outlined"
                                                  HelperText="Ai đang thực sự sử dụng thiết bị này?"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.PersonPin" />
                                </MudItem>

                                <!-- Hình thức xử lý / Service Mode -->
                                <MudItem xs="12" md="6">
                                    <MudSelect T="string" Label="Hình thức xử lý / Chế độ dịch vụ *" @bind-Value="Ticket.ServiceMode"
                                               Required="true" RequiredError="Vui lòng chọn chế độ xử lý!"
                                               Variant="Variant.Outlined">
                                        <MudSelectItem Value="@("Internal")">Sửa chữa nội bộ (Internal)</MudSelectItem>
                                        <MudSelectItem Value="@("External")">Gửi hãng / Đối tác ngoài (External)</MudSelectItem>
                                        <MudSelectItem Value="@("Onsite")">Xử lý tại chỗ/Hiện trường (Onsite)</MudSelectItem>
                                    </MudSelect>
                                </MudItem>

                                @if (Ticket.ServiceMode == "External")
                                {
                                    <MudItem xs="12">
                                        <MudSelect T="string" Label="Đơn vị cung cấp / TTBH gửi đến *" @bind-Value="Ticket.VendorId"
                                                   Required="true" RequiredError="Vui lòng chọn Đơn vị nhận bảo hành!"
                                                   Variant="Variant.Outlined">
                                            @foreach (var vendor in _vendors)
                                            {
                                                <MudSelectItem Value="@vendor.Id">@vendor.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }

                                <!-- Mô tả lỗi -->
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="Ticket.ProblemDescription"
                                                  Label="Mô tả lỗi gặp phải (Fault Description) *"
                                                  Lines="3" Variant="Variant.Outlined"
                                                  Required="true" RequiredError="Vui lòng mô tả lỗi!"
                                                  Placeholder="Nhập chi tiết tình trạng lỗi do khách hàng mô tả..." />
                                </MudItem>

                                <!-- Phụ kiện đi kèm -->
                                <MudItem xs="12">
                                    <MudText Typo="Typo.body2" Class="mb-2"><b>Phụ kiện đi kèm (Component Checklist):</b></MudText>
                                    <div class="d-flex flex-wrap">
                                        @foreach (var acc in _accessories)
                                        {
                                            <span class="acc-chip @(_selectedAcc.Contains(acc) ? "selected" : "")"
                                                  @onclick="@(() => ToggleAcc(acc))">
                                                @(_selectedAcc.Contains(acc) ? "✓" : "+") @acc
                                            </span>
                                        }
                                    </div>
                                    <div class="d-flex align-center gap-2 mt-2">
                                        <MudTextField @bind-Value="_customAcc" Label="Thêm phụ kiện khác..."
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="AddCustomAcc">Thêm</MudButton>
                                    </div>
                                </MudItem>

                                <!-- Ghi chú kỹ thuật (StaffNote) -->
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="Ticket.StaffNote"
                                                  Label="Ghi chú nhân viên / Cập nhật tiến độ ban đầu"
                                                  Lines="2" Variant="Variant.Outlined"
                                                  Placeholder="Thông tin nội bộ, ghi chú kỹ thuật ban đầu..." />
                                </MudItem>

                                <!-- Tải lên hình ảnh ngoại quan -->
                                <MudItem xs="12">
                                    <MudText Typo="Typo.body2" Class="mb-2"><b>Tải lên hình ảnh ngoại quan / Ảnh chụp S/N vật lý:</b></MudText>
                                    <div class="d-flex align-center gap-3">
                                        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesChanged" Accept=".jpg,.jpeg,.png" MaximumFileCount="5">
                                            <CustomContent>
                                                <MudButton HtmlTag="label" for="@context" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.CloudUpload">
                                                    Chọn ảnh đính kèm...
                                                </MudButton>
                                            </CustomContent>
                                        </MudFileUpload>
                                        @if (_uploading)
                                        {
                                            <MudProgressCircular Color="Color.Info" Size="Size.Small" Indeterminate="true" />
                                        }
                                    </div>
                                    
                                    @if (Ticket.Attachments != null && Ticket.Attachments.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            @foreach (var att in Ticket.Attachments)
                                            {
                                                <div class="position-relative" style="width: 80px; height: 80px; border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; overflow: visible; margin-right: 12px; margin-top: 6px;">
                                                    <MudImage Src="@(string.IsNullOrEmpty(att.Base64Data) ? att.FileUrl : $"data:image/png;base64,{att.Base64Data}")"
                                                              Alt="@att.FileName" Class="rounded-lg" Style="width: 100%; height: 100%; object-fit: cover;" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small"
                                                                   Style="position: absolute; top: -10px; right: -10px; z-index: 10; background: white; padding: 2px;"
                                                                   OnClick="@(() => RemoveAttachment(att))" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </MudItem>
                            </MudGrid>
                        </div>
                    </MudItem>

                    <!-- ====== KHỐI 4: THIẾT LẬP BAN ĐẦU KHI TIẾP NHẬN (Logistics & Status) ====== -->
                    <MudItem xs="12">
                        <div class="rma-section">
                            <div class="rma-section-header">
                                <MudIcon Icon="@Icons.Material.Filled.SettingsInputAntenna" Style="font-size:1.1rem;" />
                                3. Thiết Lập Logistics & Vị Trí Tiếp Nhận
                            </div>
                            <MudGrid Spacing="2">
                                <!-- Khẩn cấp -->
                                <MudItem xs="12" md="6" Class="d-flex align-center">
                                    <MudSwitch T="bool" @bind-Value="Ticket.IsUrgent" Color="Color.Error"
                                               Label="@(Ticket.IsUrgent ? "⚡ KHẨN CẤP – Ưu tiên ca này!" : "Mức độ xử lý bình thường")" />
                                </MudItem>

                                <!-- Vị trí tiếp nhận -->
                                <MudItem xs="12" md="6">
                                    <MudSelect T="string" Label="Vị trí tiếp nhận hiện tại *"
                                               @bind-Value="_location"
                                               Required="true" RequiredError="Chọn vị trí!"
                                               Variant="Variant.Outlined">
                                        @foreach (var loc in _locations)
                                        {
                                            <MudSelectItem Value="@loc">@loc</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </div>
                    </MudItem>
                }

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (string.IsNullOrEmpty(Ticket.Id))
        {
            <MudCheckBox T="bool" @bind-Value="_keepFormOpen"
                         Color="Color.Primary"
                         Class="ml-4"
                         Label="Giữ biểu mẫu nhập tiếp thiết bị khác" />
        }
        <MudSpacer />
        <MudButton OnClick="Cancel" Disabled="@_submitting">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.SaveAlt"
                   OnClick="Submit"
                   Disabled="@(string.IsNullOrEmpty(Ticket.Id) && CurrentDevice == null || _submitting || (CurrentDevice?.ActiveTicket != null && !_isAdmin))">
            @if (_submitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Đang xử lý...</span>
            }
            else
            {
                <span>Tiếp nhận & Lưu Phiếu RMA</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public RmaTicketDto Ticket { get; set; } = new();
    [Parameter] public EventCallback OnTicketCreated { get; set; }

    MudForm _form = null!;
    bool _valid;
    private MudTextField<string> _snInputRef = null!;

    List<CustomerDto> _customers = new();
    List<StatusMasterDto> _statuses = new();
    List<ModelDto> _models = new();
    List<VendorDto> _vendors = new();

    // S/N State
    private string _searchSerialNumber = string.Empty;
    private bool _isSearching = false;
    private bool _deviceNotFound = false;
    private DeviceSummaryDto? CurrentDevice = null;
    private bool _isAdmin = false;

    // Add New Device Form State
    private string _newDeviceCustomerId = "";
    private string _newDeviceModelId = "";
    private bool _savingNewDevice = false;

    // OCR scanning
    bool _ocrScanning;

    // Accessories
    List<string> _accessories = new() { "Adapter/Sạc", "Dây nguồn", "Pin ngoài", "Chuột", "Bàn phím", "Bao da/Túi", "Bút cảm ứng" };
    List<string> _selectedAcc = new();
    string _customAcc = "";

    // Logistics
    string _location = "Tại Cty Song Linh";
    List<string> _locations = new() { "Tại Cty Song Linh", "Tại Trung tâm Hãng", "Chỗ anh Thắng", "Kho Kỹ thuật", "Đang vận chuyển" };

    private bool _uploading;
    private bool _submitting;
    private bool _keepFormOpen;

    protected override async Task OnInitializedAsync()
    {
        // Kiểm tra quyền Admin của User đăng nhập
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAdmin = user.IsInRole("Admin");

        var custTask = CustomerService.GetCustomersAsync();
        var staTask  = TicketService.GetStatusesAsync();
        var modTask  = ReferenceService.GetModelsAsync();
        var vendTask = Http.GetFromJsonAsync<List<VendorDto>>("api/vendors");
        await Task.WhenAll(custTask, staTask, modTask, vendTask);

        _customers  = custTask.Result;
        _statuses   = staTask.Result;
        _models     = modTask.Result;
        _vendors    = vendTask.Result ?? new();

        // Nếu là mode chỉnh sửa (Edit)
        if (!string.IsNullOrEmpty(Ticket.Id))
        {
            _searchSerialNumber = Ticket.DeviceSerialNumber;
            if (Ticket.StatusHistories != null && Ticket.StatusHistories.Any())
            {
                var latestHist = Ticket.StatusHistories.First();
                _location = latestHist.LocationName;
                if (!_locations.Contains(_location))
                {
                    _locations.Add(_location);
                }
            }

            // Tự động load vòng đời
            await LookupDevice();

            // Khôi phục checklist phụ kiện đã chọn từ StaffNote
            ParseAccessoriesFromNote();
        }
        else
        {
            Ticket.ServiceMode = "Internal"; // Mặc định chế độ nội bộ
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && string.IsNullOrEmpty(Ticket.Id))
        {
            await Task.Delay(300); // Đợi Dialog khởi tạo hoàn tất
            if (_snInputRef != null)
            {
                await _snInputRef.FocusAsync();
            }
        }
    }

    private void ParseAccessoriesFromNote()
    {
        if (string.IsNullOrEmpty(Ticket.StaffNote)) return;

        var startTag = "[Phụ kiện:";
        var startIndex = Ticket.StaffNote.IndexOf(startTag, StringComparison.OrdinalIgnoreCase);
        if (startIndex == -1) return;

        var contentStart = startIndex + startTag.Length;
        var endIndex = Ticket.StaffNote.IndexOf("]", contentStart);
        if (endIndex == -1) return;

        var accsString = Ticket.StaffNote.Substring(contentStart, endIndex - contentStart).Trim();
        if (string.IsNullOrEmpty(accsString) || accsString.Equals("Không có", StringComparison.OrdinalIgnoreCase)) return;

        var accList = accsString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var acc in accList)
        {
            if (!_accessories.Contains(acc))
            {
                _accessories.Add(acc);
            }
            if (!_selectedAcc.Contains(acc))
            {
                _selectedAcc.Add(acc);
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchSerialNumber))
        {
            await LookupDevice();
        }
    }

    private async Task LookupDevice()
    {
        if (string.IsNullOrWhiteSpace(_searchSerialNumber)) return;

        // Chuẩn hóa chuỗi S/N theo thuật toán thiết kế
        _searchSerialNumber = _searchSerialNumber.Trim().ToUpper().Replace(" ", "");

        _isSearching = true;
        _deviceNotFound = false;
        CurrentDevice = null;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"api/devices/{Uri.EscapeDataString(_searchSerialNumber)}/summary");
            if (response.IsSuccessStatusCode)
            {
                CurrentDevice = await response.Content.ReadFromJsonAsync<DeviceSummaryDto>();
                if (CurrentDevice != null)
                {
                    // Tự động map định danh từ S/N (Auto-Bind ngầm)
                    Ticket.DeviceId = CurrentDevice.DeviceId;
                    Ticket.CustomerId = CurrentDevice.CustomerId;
                    Ticket.DeviceSerialNumber = CurrentDevice.SerialNumber;
                    Ticket.DeviceModelName = CurrentDevice.ModelName;
                    Ticket.CustomerName = CurrentDevice.CustomerName;
                    Ticket.DeviceWarrantyExpiry = CurrentDevice.WarrantyExpiry;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _deviceNotFound = true;
            }
            else
            {
                Snackbar.Add("Lỗi khi tải thông tin thiết bị.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi truy vấn S/N: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

