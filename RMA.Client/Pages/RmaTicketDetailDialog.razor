@using Microsoft.AspNetCore.Components.Authorization
@using RMA.Shared.DTOs
@using RMA.Client.Services
@inject IRmaTicketService TicketService
@inject CustomerService CustomerService
@inject DeviceService DeviceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100">
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" />
                <MudText Typo="Typo.h6"><b>Chi tiết Phiếu RMA #@Ticket.Id.Substring(0, Math.Min(8, Ticket.Id.Length))</b></MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <!-- Khối 1: Thông tin chung & Định danh -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Class="h-100 rounded-lg">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>1. Thông Tin Thiết Bị & Định Danh</b></MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!isEditing && !_isSales)
                            {
                                <MudTooltip Text="Chỉnh sửa nhanh thông tin thiết bị">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="StartEditing" Size="Size.Small" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" />
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="1">
                            @if (!isEditing)
                            {
                                <MudItem xs="12" Class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Khách hàng (Công ty)</MudText>
                                    <MudText Typo="Typo.body1" Class="fw-bold">@Ticket.CustomerName</MudText>
                                </MudItem>
                                <MudItem xs="6" Class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Người đại diện</MudText>
                                    <MudText Typo="Typo.body1">@Ticket.CustomerContactPerson</MudText>
                                </MudItem>
                                <MudItem xs="6" Class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Số điện thoại</MudText>
                                    <MudText Typo="Typo.body1">@Ticket.CustomerPhone</MudText>
                                </MudItem>
                                <MudItem xs="12" Class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Người dùng cuối / Phòng ban</MudText>
                                    <MudText Typo="Typo.body1">@(string.IsNullOrEmpty(Ticket.EndUserName) ? "Chưa có" : Ticket.EndUserName)</MudText>
                                </MudItem>
                                <MudItem xs="12" Class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Model Thiết bị</MudText>
                                    <MudText Typo="Typo.body1" Class="fw-bold">@Ticket.DeviceModelName</MudText>
                                </MudItem>
                                <MudItem xs="12" Class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Serial Number (S/N)</MudText>
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.body1" Class="fw-bold">
                                            @Ticket.DeviceSerialNumber
                                            @if (isApcDevice && _apcExpiryDate.HasValue)
                                            {
                                                <span style="color: var(--mud-palette-success); font-weight: bold; margin-left: 8px; font-size: 0.9rem;">
                                                    ✅ APC Smart (Hạn BH: @_apcExpiryDate.Value.ToString("dd/MM/yyyy") - @(_warrantyActive ? "Còn BH" : "Hết BH"))
                                                </span>
                                            }
                                        </MudText>
                                        @if (!string.IsNullOrEmpty(Ticket.DeviceSerialNumber))
                                        {
                                            <MudTooltip Text="Copy S/N và mở trang tra cứu bảo hành của hãng">
                                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                               Size="Size.Small"
                                                               Color="Color.Primary"
                                                               Variant="Variant.Outlined"
                                                               OnClick="LookupWarranty" />
                                            </MudTooltip>
                                        }
                                    </div>
                                </MudItem>
                                <MudItem xs="12" Class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Chế độ xử lý (Dịch vụ)</MudText>
                                    <MudText Typo="Typo.body1">@Ticket.ServiceMode</MudText>
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12">
                                    <MudTextField Value="@Ticket.CustomerName" Label="Khách hàng (Công ty)" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="6">
                                    <MudTextField Value="@Ticket.CustomerContactPerson" Label="Người đại diện" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="6">
                                    <MudTextField Value="@Ticket.CustomerPhone" Label="Số điện thoại" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="Ticket.EndUserName" Label="Người dùng cuối / Phòng ban" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSelect T="string" Label="Thiết bị (Model – S/N) *"
                                               Value="Ticket.DeviceId"
                                               ValueChanged="OnDeviceSelected"
                                               Required="true" RequiredError="Vui lòng chọn thiết bị!"
                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                        @foreach (var d in _filteredDevices)
                                        {
                                            <MudSelectItem Value="@d.Id">@d.SerialNumber – @d.ModelName</MudSelectItem>
                                        }
                                    </MudSelect>
                                    @if (isApcDevice && _apcExpiryDate.HasValue)
                                    {
                                        <div class="d-flex align-center gap-1 mt-1 text-success" style="font-size: 0.85rem;">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                            <span>Thiết bị APC: Tự động nhận diện bảo hành đến @_apcExpiryDate.Value.ToString("dd/MM/yyyy") (@(_warrantyActive ? "Còn BH" : "Hết BH"))</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Ticket.DeviceSerialNumber))
                                    {
                                        <div class="d-flex align-center gap-1 mt-1">
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                                       OnClick="LookupWarranty">
                                                Tra cứu bảo hành hãng
                                            </MudButton>
                                        </div>
                                    }
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSelect T="string" @bind-Value="Ticket.ServiceMode" Label="Chế độ xử lý" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                        <MudSelectItem Value="@("Bảo hành")">Bảo hành</MudSelectItem>
                                        <MudSelectItem Value="@("Sửa chữa")">Sửa chữa</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" Class="d-flex align-center justify-end gap-2 mt-3">
                                    <MudButton StartIcon="@Icons.Material.Filled.Cancel" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" OnClick="CancelEditing">Hủy</MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="UpdateDevice" Disabled="@isSaving">
                                        @(isSaving ? "Đang lưu..." : "Cập nhật")
                                    </MudButton>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Khối 2: Tình trạng & Luân chuyển -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Class="h-100 rounded-lg">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Color="Color.Secondary"><b>2. Tình Trạng & Luân Chuyển</b></MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Secondary" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="1">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Ticket.ProblemDescription" Label="Lỗi khách báo" ReadOnly="@(!isEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Ticket.StaffNote" Label="Ghi chú nội bộ" ReadOnly="@(!isEditing)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Value="@Ticket.ReceivedDate.ToString("dd/MM/yyyy HH:mm")" Label="Ngày nhận máy" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Value="@(Ticket.SentDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa gửi")" Label="Ngày gửi hãng/NCC" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            
                            <MudItem xs="6">
                                @if (isEditing)
                                {
                                    <MudSelect T="string" @bind-Value="Ticket.StatusId" Label="Trạng thái" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                                        @foreach (var s in _statuses)
                                        {
                                            <MudSelectItem Value="@s.Id">@s.StatusName</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <div class="d-flex align-center gap-2">
                                        <MudTextField Value="@Ticket.StatusName" Label="Trạng thái" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                        <div class="mt-2">
                                            @if (Ticket.StatusName == "Closed")
                                            {
                                                <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small">Đã hoàn tất</MudChip>
                                            }
                                            else if (Ticket.WarningColor == "Red")
                                            {
                                                <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Warning" Size="Size.Small">Quá hạn</MudChip>
                                            }
                                            else if (Ticket.WarningColor == "Yellow")
                                            {
                                                <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.Schedule" Size="Size.Small">Sắp trễ hạn</MudChip>
                                            }
                                            else if (Ticket.WarningColor == "Green")
                                            {
                                                <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small">An toàn</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">Chưa gửi</MudChip>
                                            }
                                        </div>
                                    </div>
                                }
                            </MudItem>
                            
                            <MudItem xs="6">
                                @if (isEditing)
                                {
                                    <MudTextField @bind-Value="Ticket.VendorName" Label="Đơn vị xử lý" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                }
                                else
                                {
                                    <MudTextField Value="@(string.IsNullOrEmpty(Ticket.VendorName) ? "Nội bộ" : Ticket.VendorName)" Label="Đơn vị xử lý" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                }
                            </MudItem>

                            <MudItem xs="12" Class="d-flex align-center">
                                <MudSwitch T="bool" @bind-Value="Ticket.IsUrgent" ReadOnly="@(!isEditing)" Color="Color.Error" Label="Ưu tiên (Khẩn)" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Khối 3: Phụ kiện & Hình ảnh -->
            <MudItem xs="12">
                <MudCard Elevation="1" Class="rounded-lg">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Color="Color.Tertiary"><b>3. Phụ Kiện & Hình Ảnh</b></MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Tertiary" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.body2" Class="mb-2 fw-bold">Checklist Phụ kiện nhận kèm:</MudText>
                                @if (isEditing)
                                {
                                    <div class="d-flex flex-wrap">
                                        @foreach (var acc in _accessories)
                                        {
                                            <span class="acc-chip @(_selectedAcc.Contains(acc) ? "selected" : "")"
                                                  @onclick="@(() => ToggleAcc(acc))"
                                                  style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 20px; margin: 3px; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; border: 1.5px solid #c5c6f7; background: #fff; color: #5b5fc7; user-select: none; @(_selectedAcc.Contains(acc) ? "background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-color: transparent; box-shadow: 0 2px 8px rgba(102,126,234,0.35);" : "")">
                                                @(_selectedAcc.Contains(acc) ? "✓" : "+") @acc
                                            </span>
                                        }
                                    </div>
                                    <div class="d-flex align-center gap-2 mt-2">
                                        <MudTextField @bind-Value="_customAcc" Label="Thêm phụ kiện khác..."
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="AddCustomAcc">Thêm</MudButton>
                                    </div>
                                }
                                else
                                {
                                    @if (Ticket.Checklists != null && Ticket.Checklists.Any(item => item.IsChecked))
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var item in Ticket.Checklists.Where(item => item.IsChecked))
                                            {
                                                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                                                    ✓ @item.ItemName
                                                </MudChip>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Không có phụ kiện đính kèm được ghi nhận.</MudText>
                                    }
                                }
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudText Typo="Typo.body2" Class="mb-2 fw-bold">Hình ảnh hiện trạng:</MudText>
                                @if (isEditing)
                                {
                                    <div class="d-flex align-center gap-3 mb-2">
                                        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesChanged" Accept=".jpg,.jpeg,.png" MaximumFileCount="5">
                                            <CustomContent>
                                                <MudButton HtmlTag="label" for="@context" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.CloudUpload">
                                                    Chọn ảnh tải lên...
                                                </MudButton>
                                            </CustomContent>
                                        </MudFileUpload>
                                        @if (_uploading)
                                        {
                                            <MudProgressCircular Color="Color.Info" Size="Size.Small" Indeterminate="true" />
                                        }
                                    </div>

                                    @if (Ticket.Attachments != null && Ticket.Attachments.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            @foreach (var att in Ticket.Attachments)
                                            {
                                                <div class="position-relative" style="width: 80px; height: 80px; border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; overflow: visible; margin-right: 12px; margin-top: 6px;">
                                                    <MudImage Src="@(string.IsNullOrEmpty(att.Base64Data) ? att.FileUrl : $"data:image/png;base64,{att.Base64Data}")"
                                                              Alt="@att.FileName" Class="rounded-lg" Style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;" @onclick="@(() => OpenImagePreview(string.IsNullOrEmpty(att.Base64Data) ? att.FileUrl : $"data:image/png;base64,{att.Base64Data}"))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small"
                                                                   Style="position: absolute; top: -10px; right: -10px; z-index: 10; background: white; padding: 2px;"
                                                                   OnClick="@(() => RemoveAttachment(att))" />
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    @if (Ticket.Attachments != null && Ticket.Attachments.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var img in Ticket.Attachments)
                                            {
                                                <MudImage Src="@img.FileUrl" Alt="@img.FileName" Elevation="2" Class="rounded-lg" Style="height: 80px; width: 80px; object-fit: cover; cursor: pointer;" @onclick="@(() => OpenImagePreview(img.FileUrl))" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Chưa có hình ảnh đính kèm.</MudText>
                                    }
                                }
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Khối 4: Lịch sử di chuyển (Timeline) -->
            <MudItem xs="12">
                <MudCard Elevation="1" Class="rounded-lg">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Color="Color.Info"><b>4. Lịch Sử Trạng Thái (Timeline)</b></MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Info" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (Ticket.StatusHistories != null && Ticket.StatusHistories.Any())
                        {
                            <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                                @foreach (var hist in Ticket.StatusHistories.OrderByDescending(h => h.CreatedAt))
                                {
                                    <MudTimelineItem Color="GetStatusColor(hist.StatusName)" Size="Size.Small">
                                        <ItemOpposite>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@hist.CreatedAt.ToString("dd/MM/yyyy HH:mm")</MudText>
                                        </ItemOpposite>
                                        <ItemContent>
                                            <MudText Typo="Typo.body2" Class="fw-bold">@hist.StatusName</MudText>
                                            <MudText Typo="Typo.caption">Vị trí: @hist.LocationName</MudText>
                                            @if (!string.IsNullOrEmpty(hist.Note))
                                            {
                                                <MudText Typo="Typo.body2" Class="mt-1">@hist.Note</MudText>
                                            }
                                        </ItemContent>
                                    </MudTimelineItem>
                                }
                            </MudTimeline>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Chưa có lịch sử trạng thái nào.</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Khối 5: Bản đồ vị trí khách hàng -->
            @if (customer != null && !string.IsNullOrEmpty(customer.Address))
            {
                <MudItem xs="12">
                    <MudCard Elevation="1" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>5. Bản Đồ Vị Trí Khách Hàng</b></MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIcon Icon="@Icons.Material.Filled.Map" Color="Color.Primary" />
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <iframe 
                                src="https://maps.google.com/maps?q=@Uri.EscapeDataString(customer.Address)&output=embed" 
                                width="100%" 
                                height="350" 
                                style="border:0; border-radius: 8px;" 
                                allowfullscreen="" 
                                loading="lazy">
                            </iframe>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Print" Color="Color.Default" Variant="Variant.Outlined" OnClick="PrintReceipt">In Biên Nhận PDF</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Assignment" Color="Color.Primary" Variant="Variant.Outlined" Class="mr-auto ml-2" OnClick="OpenHandoverDialog">Xuất BBBG</MudButton>
        <MudButton OnClick="Close" Variant="Variant.Text">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public RmaTicketDto Ticket { get; set; } = new();
    [Parameter] public EventCallback<RmaTicketDto> OnTicketUpdated { get; set; }

    private bool isEditing = false;
    private bool isSaving = false;
    private List<StatusMasterDto> _statuses = new();
    private CustomerDto? customer;

    private List<DeviceDto> _filteredDevices = new();
    private List<string> _accessories = new() { "Adapter/Sạc", "Dây nguồn", "Pin ngoài", "Chuột", "Bàn phím", "Bao da/Túi", "Bút cảm ứng" };
    private List<string> _selectedAcc = new();
    private string _customAcc = "";
    private bool _uploading = false;
    private string _location = "Tại Cty Song Linh";
    private bool _warrantyActive = true;

    private RmaTicketDto _ticketBackup = new();
    private bool isApcDevice = false;
    private DateTime? _apcExpiryDate;
    private bool _isSales = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isSales = user.IsInRole("Sales");

        _statuses = await TicketService.GetStatusesAsync();
        
        try
        {
            var allDevices = await DeviceService.GetDevicesAsync();
            if (!string.IsNullOrEmpty(Ticket.CustomerId))
            {
                _filteredDevices = allDevices.Where(d => d.CustomerId == Ticket.CustomerId).ToList();
                customer = await CustomerService.GetCustomerAsync(Ticket.CustomerId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading initial data: {ex.Message}");
        }

        // Initialize accessories checklist from DTO
        if (Ticket.Checklists != null)
        {
            _selectedAcc = Ticket.Checklists.Where(c => c.IsChecked).Select(c => c.ItemName).ToList();
            foreach (var item in Ticket.Checklists.Where(c => c.IsChecked))
            {
                if (!_accessories.Contains(item.ItemName))
                {
                    _accessories.Add(item.ItemName);
                }
            }
        }

        // Parse metadata from StaffNote
        if (!string.IsNullOrEmpty(Ticket.StaffNote))
        {
            // Parse Location
            var locStart = Ticket.StaffNote.IndexOf("[Vị trí:", StringComparison.OrdinalIgnoreCase);
            if (locStart != -1)
            {
                var locEnd = Ticket.StaffNote.IndexOf("]", locStart);
                if (locEnd != -1)
                {
                    _location = Ticket.StaffNote.Substring(locStart + 8, locEnd - (locStart + 8)).Trim();
                }
            }

            // Parse Warranty
            var bhStart = Ticket.StaffNote.IndexOf("[BH:", StringComparison.OrdinalIgnoreCase);
            if (bhStart != -1)
            {
                var bhEnd = Ticket.StaffNote.IndexOf("]", bhStart);
                if (bhEnd != -1)
                {
                    var bhStr = Ticket.StaffNote.Substring(bhStart + 4, bhEnd - (bhStart + 4)).Trim();
                    _warrantyActive = bhStr.Equals("Còn BH", StringComparison.OrdinalIgnoreCase);
                }
            }
        }

        CheckApcWarranty();
    }

