@using RMA.Shared.DTOs
@inject RMA.Client.Services.CustomerService CustomerService
@inject RMA.Client.Services.DeviceService DeviceService
@inject RMA.Client.Services.IRmaTicketService TicketService
@inject RMA.Client.Services.ReferenceDataService ReferenceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<style>
    .rma-section {
        border: 1px solid rgba(99,102,241,0.18);
        border-radius: 12px;
        padding: 16px 20px 20px 20px;
        margin-bottom: 18px;
        background: linear-gradient(135deg, rgba(255,255,255,0.85) 0%, rgba(249,250,255,0.9) 100%);
        box-shadow: 0 2px 10px rgba(99,102,241,0.06);
        transition: box-shadow 0.2s;
    }
    .rma-section:hover { box-shadow: 0 4px 18px rgba(99,102,241,0.13); }
    .rma-section-header {
        display: flex; align-items: center; gap: 8px;
        font-weight: 700; font-size: 0.85rem; letter-spacing: 0.04em;
        color: #5b5fc7; text-transform: uppercase;
        border-bottom: 2px solid rgba(99,102,241,0.15);
        padding-bottom: 8px; margin-bottom: 14px;
    }
    .ocr-box {
        border: 2px dashed #64b5f6;
        border-radius: 8px; padding: 12px;
        background: rgba(33,150,243,0.04);
        text-align: center; position: relative; overflow: hidden;
    }
    .scan-line {
        position: absolute; left: 0; width: 100%; height: 3px;
        background: linear-gradient(90deg, transparent, #2196f3, transparent);
        animation: scanMove 1.4s linear infinite;
        box-shadow: 0 0 8px #2196f3;
    }
    @@keyframes scanMove { 0%{top:0} 50%{top:100%} 100%{top:0} }
    .warranty-box {
        border-radius: 8px; padding: 10px 14px; margin-top: 8px;
        transition: all 0.3s;
    }
    .warranty-ok { background: rgba(76,175,80,0.08); border: 1px solid rgba(76,175,80,0.25); }
    .warranty-exp { background: rgba(255,152,0,0.08); border: 1px solid rgba(255,152,0,0.25); }
    .brand-link {
        display: inline-flex; align-items: center; gap: 5px;
        color: #43a047; font-weight: 600; text-decoration: none;
    }
    .brand-link:hover { text-decoration: underline; }
    .acc-chip {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 20px; margin: 3px;
        font-size: 0.8rem; cursor: pointer; transition: all 0.2s;
        border: 1.5px solid #c5c6f7; background: #fff; color: #5b5fc7;
        user-select: none;
    }
    .acc-chip.selected {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff; border-color: transparent;
        box-shadow: 0 2px 8px rgba(102,126,234,0.35);
    }
    .device-passport-card {
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.08);
        background: #fdfdfd;
        transition: all 0.25s ease;
    }
    .device-passport-card:hover {
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    }
    .device-passport-indicator {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 6px;
        border-radius: 6px 0 0 6px;
    }
    .warranty-active-bar { background: linear-gradient(180deg, #2e7d32 0%, #4caf50 100%); }
    .warranty-warning-bar { background: linear-gradient(180deg, #e65100 0%, #ff9800 100%); }
    .warranty-expired-bar { background: linear-gradient(180deg, #b71c1c 0%, #f44336 100%); }
    
    .passport-grid {
        padding: 16px 20px 16px 26px;
    }
    .passport-label {
        font-size: 0.72rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        margin-bottom: 2px;
    }
    .passport-value {
        font-size: 0.88rem;
        color: #1e293b;
        font-weight: 600;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudGrid Spacing="0">

                <!-- ====== KHỐI 1: ĐỊNH DANH ====== -->
                <MudItem xs="12">
                    <div class="rma-section">
                        <div class="rma-section-header">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Style="font-size:1.1rem;" />
                            1. Thông Tin Định Danh (Identification)
                        </div>
                        <MudGrid>
                            <!-- Serial Number (S/N) Lookup -->
                            <MudItem xs="12" md="6">
                                <div class="d-flex align-start gap-2">
                                    <MudTextField @bind-Value="_searchSerial"
                                                  Label="Nhập Serial Number (S/N) *"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="VD: SN-123456..."
                                                  Required="true" RequiredError="Vui lòng nhập S/N!"
                                                  OnKeyDown="@(async (e) => { if (e.Key == "Enter") await SearchSerialNumber(); })"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@Icons.Material.Filled.CameraAlt"
                                                  OnAdornmentClick="TriggerOcrScan"
                                                  Class="flex-grow-1" />
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Search"
                                               OnClick="SearchSerialNumber"
                                               Disabled="_searchingSerial"
                                               Style="height: 56px;"
                                               Class="px-6">
                                        @if (_searchingSerial)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        }
                                        else
                                        {
                                            <span>Tìm</span>
                                        }
                                    </MudButton>
                                </div>
                                <InputFile id="ocrInput" OnChange="UploadImageForOcr" accept="image/*" style="display:none;" />
                                
                                @if (_ocrScanning)
                                {
                                    <div class="ocr-box mt-2">
                                        <div class="scan-line"></div>
                                        <MudProgressLinear Color="Color.Info" Indeterminate="true" Class="mb-2" />
                                        <MudText Typo="Typo.caption" Color="Color.Info">
                                            <b>🔍 Đang quét và phân tích Serial Number...</b>
                                        </MudText>
                                    </div>
                                }
                            </MudItem>

                            <!-- Người dùng cuối / Phòng ban -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="Ticket.EndUserName"
                                              Label="Người dùng cuối / Phòng ban (Tùy chọn)"
                                              Placeholder="VD: Nguyễn Thành Tâm P.TK, Trần Văn B P.KT..."
                                              Variant="Variant.Outlined"
                                              HelperText="Ai đang thực sự sử dụng thiết bị này?"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Badge" />
                            </MudItem>

                            <!-- Hiển thị kết quả tra cứu hoặc form thêm mới -->
                            <MudItem xs="12">
                                @if (_searchedDevice != null)
                                {
                                    <MudPaper Outlined="true" Elevation="1" Class="device-passport-card mt-2 mb-2">
                                        <!-- Vertical left colored status bar -->
                                        <div class="device-passport-indicator @GetWarrantyBarClass(_warrantyStatusColor)"></div>

                                        <MudGrid Class="passport-grid align-center" Spacing="2">
                                            <!-- Brand & Model Name -->
                                            <MudItem xs="12" sm="6" md="4">
                                                <div class="passport-label">Thiết bị / Sản phẩm</div>
                                                <div class="passport-value d-flex align-center gap-1">
                                                    <span style="font-weight: 700; color: #1e1b4b;">@_searchedDevice.Brand</span>
                                                    <span style="color: #64748b;">•</span>
                                                    <span style="font-weight: 500;">@_searchedDevice.ModelName</span>
                                                </div>
                                            </MudItem>

                                            <!-- Customer -->
                                            <MudItem xs="12" sm="6" md="4">
                                                <div class="passport-label">Khách hàng sở hữu</div>
                                                <div class="passport-value" style="font-weight: 600; color: #3b82f6;">
                                                    @_searchedDevice.CustomerName
                                                </div>
                                            </MudItem>

                                            <!-- Status -->
                                            <MudItem xs="12" sm="6" md="4" Class="d-flex align-center justify-space-between">
                                                <div>
                                                    <div class="passport-label">Trạng thái bảo hành</div>
                                                    <div class="passport-value">
                                                        <span style="font-weight: 700; color: @GetWarrantyColorHex(_warrantyStatusColor)">
                                                            @_warrantyStatus
                                                        </span>
                                                    </div>
                                                </div>
                                                <MudTooltip Text="Chọn S/N khác">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="ClearSearchedDevice" Class="mr-2" />
                                                </MudTooltip>
                                            </MudItem>

                                            <!-- Purchase Date -->
                                            <MudItem xs="6" sm="4" md="3">
                                                <div class="passport-label">Ngày mua hàng</div>
                                                <div class="passport-value">
                                                    @(_searchedDevice.PurchaseDate?.ToString("dd/MM/yyyy") ?? "Chưa rõ")
                                                </div>
                                            </MudItem>

                                            <!-- Expiry Date -->
                                            <MudItem xs="6" sm="4" md="3">
                                                <div class="passport-label">Ngày hết hạn</div>
                                                <div class="passport-value">
                                                    @(_searchedDevice.WarrantyExpiry?.ToString("dd/MM/yyyy") ?? "Chưa rõ")
                                                </div>
                                            </MudItem>

                                            <!-- Order Code -->
                                            <MudItem xs="6" sm="4" md="3">
                                                <div class="passport-label">Mã đơn hàng</div>
                                                <div class="passport-value">
                                                    <span style="font-family: monospace; font-weight: bold; background: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-size: 0.8rem;">
                                                        @if (string.IsNullOrWhiteSpace(_searchedDevice.OrderCode))
                                                        {
                                                            <span style="color: #d32f2f;">Chưa có</span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color: #0072BC;">@_searchedDevice.OrderCode</span>
                                                        }
                                                    </span>
                                                </div>
                                            </MudItem>

                                            <!-- Online Lookup Link -->
                                            <MudItem xs="6" sm="12" md="3" Class="d-flex align-center justify-end">
                                                <a href="@GetWarrantyUrl()" target="_blank" class="brand-link" style="font-size: 0.85rem; font-weight: 600;">
                                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Style="font-size:1rem; margin-right: 4px;" />
                                                    Tra cứu bảo hành hãng
                                                </a>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }
                                else if (_deviceNotFound)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-2">
                                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                            <MudText>Không tìm thấy S/N <b>@_searchSerial</b> trong hệ thống. Bạn có muốn thêm S/N này không?</MudText>
                                            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" OnClick="PrepareAddDevice">
                                                Có, Thêm Thiết Bị Mới
                                            </MudButton>
                                        </div>
                                    </MudAlert>
                                }

                                @if (_showAddDevice)
                                {
                                    <MudCard Elevation="2" Class="mt-3 pa-4" Style="border-left: 4px solid #29b6f6; background-color: #f7fcfe;">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Info" Class="mb-3">
                                            <b>📝 THÊM MỚI THIẾT BỊ VÀO HỆ THỐNG</b>
                                        </MudText>
                                        <MudGrid>
                                            <!-- Model -->
                                            <MudItem xs="12" md="6">
                                                <div class="d-flex align-end gap-2">
                                                    <MudSelect T="string" Label="Dòng sản phẩm (Model) *" @bind-Value="_newDeviceModelId"
                                                               Variant="Variant.Outlined" Required="true" RequiredError="Vui lòng chọn Model!">
                                                        @foreach (var m in _models)
                                                        {
                                                            <MudSelectItem Value="@m.Id">@m.ModelName (@m.Brand)</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                    <MudTooltip Text="Thêm dòng máy mới">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenAddModelDialog" Style="height: 56px;" />
                                                    </MudTooltip>
                                                </div>
                                            </MudItem>

                                            <!-- Customer -->
                                            <MudItem xs="12" md="6">
                                                <div class="d-flex align-end gap-2">
                                                    <MudSelect T="string" Label="Khách hàng sở hữu *" @bind-Value="Ticket.CustomerId"
                                                               Variant="Variant.Outlined" Required="true" RequiredError="Vui lòng chọn khách hàng!">
                                                        @foreach (var c in _customers)
                                                        {
                                                            <MudSelectItem Value="@c.Id">@c.Name @(c.Phone != null ? $"({c.Phone})" : "")</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                    <MudTooltip Text="Thêm khách hàng mới">
                                                        <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenAddCustomerDialog" Style="height: 56px;" />
                                                    </MudTooltip>
                                                </div>
                                            </MudItem>

                                            <!-- S/N -->
                                            <MudItem xs="12" md="4">
                                                <MudTextField @bind-Value="_newDeviceSerial" Label="Số Sê-ri (S/N) *" Variant="Variant.Outlined" Disabled="true" />
                                            </MudItem>

                                            <!-- Dates -->
                                            <MudItem xs="12" md="4">
                                                <MudDatePicker Label="Ngày giao hàng / mua *" @bind-Date="_newDevicePurchaseDate" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudDatePicker Label="Ngày hết hạn bảo hành *" @bind-Date="_newDeviceWarrantyExpiry" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                        </MudGrid>
                                        <div class="d-flex justify-end gap-2 mt-4">
                                            <MudButton OnClick="CancelAddDevice">Hủy</MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveDevice">
                                                Lưu Thiết Bị & Chọn
                                            </MudButton>
                                        </div>
                                    </MudCard>
                                }
                            </MudItem>

                            <!-- Urgent toggle + Service Mode -->
                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool" @bind-Value="Ticket.IsUrgent" Color="Color.Error"
                                           Label="@(Ticket.IsUrgent ? "⚡ KHẨN CẤP – Ưu tiên xử lý!" : "Mức độ bình thường")" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Label="Chế độ xử lý *" @bind-Value="Ticket.ServiceMode"
                                           Required="true" RequiredError="Vui lòng chọn chế độ xử lý!"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("Bảo hành")">Bảo hành</MudSelectItem>
                                    <MudSelectItem Value="@("Sửa chữa")">Sửa chữa</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudItem>

                <!-- ====== KHỐI 2: TÌNH TRẠNG & PHỤ KIỆN ====== -->
                <MudItem xs="12">
                    <div class="rma-section">
                        <div class="rma-section-header">
                            <MudIcon Icon="@Icons.Material.Filled.Construction" Style="font-size:1.1rem;" />
                            2. Tình Trạng & Phụ Kiện (Condition & Accessories)
                        </div>
                        <MudGrid>
                            <!-- Mô tả lỗi (Full width) -->
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Ticket.ProblemDescription"
                                              Label="Mô tả lỗi (Fault Description) *"
                                              Lines="3" Variant="Variant.Outlined"
                                              Required="true" RequiredError="Vui lòng mô tả lỗi!"
                                              Placeholder="Nhập chi tiết tình trạng lỗi do khách hàng mô tả..." />
                            </MudItem>

                            <!-- Phụ kiện đi kèm -->
                            <MudItem xs="12">
                                <MudText Typo="Typo.body2" Class="mb-2"><b>Phụ kiện đi kèm (Component Checklist):</b></MudText>
                                <div class="d-flex flex-wrap">
                                    @foreach (var acc in _accessories)
                                    {
                                        <span class="acc-chip @(_selectedAcc.Contains(acc) ? "selected" : "")"
                                              @onclick="@(() => ToggleAcc(acc))">
                                            @(_selectedAcc.Contains(acc) ? "✓" : "+") @acc
                                        </span>
                                    }
                                </div>
                                <div class="d-flex align-center gap-2 mt-2">
                                    <MudTextField @bind-Value="_customAcc" Label="Thêm phụ kiện khác..."
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               OnClick="AddCustomAcc">Thêm</MudButton>
                                </div>
                            </MudItem>

                            <!-- Upload hình ảnh đính kèm -->
                            <MudItem xs="12" Class="mt-3">
                                <MudText Typo="Typo.body2" Class="mb-2"><b>Tải lên hình ảnh hiện trạng (Serial / Ngoại quan):</b></MudText>
                                <div class="d-flex align-center gap-3">
                                    <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesChanged" Accept=".jpg,.jpeg,.png" MaximumFileCount="5">
                                        <CustomContent>
                                            <MudButton HtmlTag="label" for="@context" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.CloudUpload">
                                                Chọn ảnh tải lên...
                                            </MudButton>
                                        </CustomContent>
                                    </MudFileUpload>
                                    @if (_uploading)
                                    {
                                        <MudProgressCircular Color="Color.Info" Size="Size.Small" Indeterminate="true" />
                                    }
                                </div>
                                
                                @if (Ticket.Attachments != null && Ticket.Attachments.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @foreach (var att in Ticket.Attachments)
                                        {
                                            <div class="position-relative" style="width: 80px; height: 80px; border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; overflow: visible; margin-right: 12px; margin-top: 6px;">
                                                <MudImage Src="@(string.IsNullOrEmpty(att.Base64Data) ? att.FileUrl : $"data:image/png;base64,{att.Base64Data}")"
                                                          Alt="@att.FileName" Class="rounded-lg" Style="width: 100%; height: 100%; object-fit: cover;" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small"
                                                               Style="position: absolute; top: -10px; right: -10px; z-index: 10; background: white; padding: 2px;"
                                                               OnClick="@(() => RemoveAttachment(att))" />
                                            </div>
                                        }
                                    </div>
                                }
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudItem>

                <!-- ====== KHỐI 3: LUÂN CHUYỂN & THEO DÕI ====== -->
                <MudItem xs="12">
                    <div class="rma-section">
                        <div class="rma-section-header">
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:1.1rem;" />
                            3. Luân Chuyển & Theo Dõi (Logistics & Tracking)
                        </div>
                        <MudGrid>
                            <!-- Ngày gửi -->
                            <MudItem xs="12" md="4">
                                <MudDatePicker Label="Ngày gửi sửa (Sent Date) *"
                                               @bind-Date="_sentDate"
                                               Variant="Variant.Outlined"
                                               Required="true" RequiredError="Ngày gửi là bắt buộc!"
                                               HelperText="Mốc tính Cảnh báo 14 ngày (Xanh→Vàng→Đỏ)" />
                            </MudItem>

                            <!-- Vị trí -->
                            <MudItem xs="12" md="4">
                                <div class="d-flex align-end gap-2">
                                    <MudSelect T="string" Label="Vị trí hiện tại *"
                                               @bind-Value="_location"
                                               Required="true" RequiredError="Chọn vị trí!"
                                               Variant="Variant.Outlined" Class="flex-grow-1">
                                        @foreach (var loc in _locations)
                                        {
                                            <MudSelectItem Value="@loc">@loc</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudTooltip Text="Thêm vị trí mới">
                                        <MudIconButton Icon="@Icons.Material.Filled.AddLocation"
                                                       Color="Color.Secondary" Variant="Variant.Outlined"
                                                       OnClick="AddLocation" />
                                    </MudTooltip>
                                </div>
                            </MudItem>

                            <!-- Trạng thái xử lý -->
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Label="Trạng thái xử lý *"
                                           @bind-Value="Ticket.StatusId"
                                           Required="true" RequiredError="Chọn trạng thái!"
                                           Variant="Variant.Outlined">
                                    @foreach (var s in _statuses)
                                    {
                                        <MudSelectItem Value="@s.Id">@s.StatusName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!-- Ghi chú nhân viên -->
                            <MudItem xs="12">
                                <MudTextField @bind-Value="Ticket.StaffNote"
                                              Label="Ghi chú nhân viên / Cập nhật tiến độ"
                                              Lines="2" Variant="Variant.Outlined"
                                              Placeholder="Thông tin nội bộ, cập nhật tiến độ..." />
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (string.IsNullOrEmpty(Ticket.Id))
        {
            <MudCheckBox T="bool" @bind-Value="_keepFormOpen"
                         Color="Color.Primary"
                         Class="ml-4"
                         Label="Giữ biểu mẫu để nhập liên tục thiết bị tương tự" />
        }
        <MudSpacer />
        <MudButton OnClick="Cancel" Disabled="@_submitting">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.SaveAlt"
                   OnClick="Submit"
                   Disabled="@_submitting">
            @if (_submitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Đang xử lý...</span>
            }
            else
            {
                <span>Tiếp nhận & Lưu Phiếu RMA</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public RmaTicketDto Ticket { get; set; } = new();
    [Parameter] public EventCallback OnTicketCreated { get; set; }

    MudForm _form = null!;
    bool _valid;

    // Data lists
    List<CustomerDto> _customers = new();
    List<DeviceDto> _allDevices = new();
    List<DeviceDto> _filteredDevices = new();
    List<StatusMasterDto> _statuses = new();
    List<ModelDto> _models = new();

    // Khối 1 state
    bool _showAddDevice;
    string _newDeviceModelId = "";
    string _newDeviceSerial = "";
    bool _ocrScanning;
    private Dictionary<string, string> _pendingDeviceCustomerUpdates = new();
    
    // New search state
    string _searchSerial = "";
    bool _searchingSerial = false;
    DeviceDto? _searchedDevice = null;
    string _warrantyStatus = "";
    string _warrantyStatusColor = "";
    bool _deviceNotFound = false;
    DateTime? _newDevicePurchaseDate = DateTime.Today;
    DateTime? _newDeviceWarrantyExpiry = DateTime.Today.AddYears(1);

    // Khối 2 state
    bool _warrantyActive = true;
    string _deviceBrand = "Hãng";
    List<string> _accessories = new() { "Adapter/Sạc", "Dây nguồn", "Pin ngoài", "Chuột", "Bàn phím", "Bao da/Túi", "Bút cảm ứng" };
    List<string> _selectedAcc = new();
    string _customAcc = "";

    // Khối 3 state
    DateTime? _sentDate = DateTime.Today;
    string _location = "Tại Cty Song Linh";
    List<string> _locations = new() { "Tại Cty Song Linh", "Tại Trung tâm Hãng", "Chỗ anh Thắng", "Kho Kỹ thuật", "Đang vận chuyển" };

    protected override async Task OnInitializedAsync()
    {
        var custTask = CustomerService.GetCustomersAsync();
        var devTask  = DeviceService.GetDevicesAsync();
        var staTask  = TicketService.GetStatusesAsync();
        var modTask  = ReferenceService.GetModelsAsync();
        await Task.WhenAll(custTask, devTask, staTask, modTask);

        _customers  = custTask.Result;
        _allDevices = devTask.Result;
        _statuses   = staTask.Result;
        _models     = modTask.Result;

        if (!string.IsNullOrEmpty(Ticket.CustomerId))
            _filteredDevices = _allDevices.Where(d => d.CustomerId == Ticket.CustomerId).ToList();

        if (Ticket.SentDate.HasValue) _sentDate = Ticket.SentDate.Value;

        // If editing a ticket that already has a device serial
        if (!string.IsNullOrEmpty(Ticket.DeviceSerialNumber))
        {
            _searchSerial = Ticket.DeviceSerialNumber;
            var matchedDev = _allDevices.FirstOrDefault(d => d.SerialNumber.Equals(Ticket.DeviceSerialNumber, StringComparison.OrdinalIgnoreCase));
            if (matchedDev != null)
            {
                _searchedDevice = matchedDev;
                CalculateWarrantyStatus(matchedDev.WarrantyExpiry);
            }
        }
    }

    void OnCustomerChanged(string id)
    {
        var oldDeviceId = Ticket.DeviceId;
        Ticket.CustomerId = id;
        _filteredDevices  = _allDevices.Where(d => d.CustomerId == id).ToList();

        if (!string.IsNullOrEmpty(oldDeviceId))
        {
            var oldDev = _allDevices.FirstOrDefault(d => d.Id == oldDeviceId);
            if (oldDev != null)
            {
                var matchingDevice = _filteredDevices.FirstOrDefault(d => d.SerialNumber.Equals(oldDev.SerialNumber, StringComparison.OrdinalIgnoreCase));
                if (matchingDevice != null)
                {
                    Ticket.DeviceId = matchingDevice.Id;
                }
                else
                {
                    // Transfer the device to the new customer in memory
                    oldDev.CustomerId = id;
                    _filteredDevices = _allDevices.Where(d => d.CustomerId == id).ToList();
                    Ticket.DeviceId = oldDev.Id;
                    
                    _pendingDeviceCustomerUpdates[oldDev.Id] = id;
                }
            }
            else
            {
                Ticket.DeviceId = "";
            }
        }
        else
        {
            Ticket.DeviceId = "";
        }
        UpdateBrand();
    }

    void UpdateBrand()
    {
        if (_searchedDevice != null && Ticket.DeviceId == _searchedDevice.Id)
        {
            _deviceBrand = _searchedDevice.Brand ?? "Hãng";
            return;
        }
        var dev = _allDevices.FirstOrDefault(d => d.Id == Ticket.DeviceId);
        _deviceBrand = dev?.Brand ?? "Hãng";
    }

    string GetWarrantyUrl()
    {
        UpdateBrand();
        return _deviceBrand.ToLower() switch
        {
            "dell"  => $"https://www.dell.com/support/home/vi-vn?app=warranty&SerialNumber={Ticket.DeviceSerialNumber}",
            "apple" => "https://checkcoverage.apple.com/vn/vi/",
            "asus"  => "https://www.asus.com/vn/support/warranty-status-inquiry/",
            "hp"    => "https://support.hp.com/vn-vi/check-warranty",
            _       => $"https://www.google.com/search?q=tra+cuu+bao+hanh+{Uri.EscapeDataString(_deviceBrand)}"
        };
    }

