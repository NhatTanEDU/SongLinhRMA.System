@using RMA.Shared.DTOs
@inject RMA.Client.Services.DeviceService DeviceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudTable Items="@devices" Dense="true" Hover="true" Striped="true" Filter="new Func<DeviceDto,bool>(FilterFunc)" @bind-SelectedItem="selectedItem">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Device List</MudText>
        <MudSpacer />
        @if (!ReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDeviceDialog">Thêm Thiết Bị</MudButton>
        }
        <MudSpacer />
        <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>STT</MudTh>
        <MudTh>Serial Number</MudTh>
        <MudTh>Model</MudTh>
        <MudTh>Brand</MudTh>
        <MudTh>Customer</MudTh>
        @if (!ReadOnly)
        {
            <MudTh>Thao tác</MudTh>
        }
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="STT">@(devices.IndexOf(context) + 1)</MudTd>
        <MudTd DataLabel="Serial Number">
            @if (string.IsNullOrWhiteSpace(context.SerialNumber) || context.SerialNumber.Equals("KHÔNG CÓ S/N", StringComparison.OrdinalIgnoreCase))
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text" Style="color: #757575; font-style: italic; margin: 0; padding: 0;">Không có S/N</MudChip>
            }
            else if (context.SerialNumber.StartsWith("SYS-") || context.SerialNumber.StartsWith("NOSERIAL-"))
            {
                <MudTooltip Text="@context.SerialNumber">
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text" Style="color: #9e9e9e; font-style: italic; margin: 0; padding: 0;">Hệ thống tự sinh</MudChip>
                </MudTooltip>
            }
            else
            {
                <span class="fw-bold" style="color: #2c3e50;">@context.SerialNumber</span>
            }
        </MudTd>
        <MudTd DataLabel="Model">@context.ModelName</MudTd>
        <MudTd DataLabel="Brand">@context.Brand</MudTd>
        <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
        @if (!ReadOnly)
        {
            <MudTd DataLabel="Thao tác">
                <MudTooltip Text="Sửa thiết bị">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenEditDeviceDialog(context))" />
                </MudTooltip>
                <MudTooltip Text="Xóa thiết bị">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDeleteDevice(context))" />
                </MudTooltip>
            </MudTd>
        }
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    [Parameter] public bool ReadOnly { get; set; } = false;

    private List<DeviceDto> devices = new List<DeviceDto>();
    private string searchString = "";
    private DeviceDto? selectedItem = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        devices = await DeviceService.GetDevicesAsync();
    }

    private async Task OpenAddDeviceDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<DeviceDialog>("Thêm Thiết Bị", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var newDevice = (DeviceCreateDto)result.Data!;
            var added = await DeviceService.CreateDeviceAsync(newDevice);
            if (added != null)
            {
                Snackbar.Add("Thêm thiết bị thành công!", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Thêm thiết bị thất bại!", Severity.Error);
            }
        }
    }

    private bool FilterFunc(DeviceDto element)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.SerialNumber != null && element.SerialNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.ModelName != null && element.ModelName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.CustomerName != null && element.CustomerName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private async Task OpenEditDeviceDialog(DeviceDto device)
    {
        var editDto = new DeviceCreateDto
        {
            SerialNumber = device.SerialNumber ?? string.Empty,
            CustomerId = device.CustomerId ?? string.Empty,
            ModelId = device.ModelId ?? string.Empty,
            PurchaseDate = device.PurchaseDate,
            WarrantyExpiry = device.WarrantyExpiry
        };

        var parameters = new DialogParameters { ["Device"] = editDto };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<DeviceDialog>("Sửa Thiết Bị", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var updatedDevice = (DeviceCreateDto)result.Data!;
            // Standardize S/N format
            if (!string.IsNullOrWhiteSpace(updatedDevice.SerialNumber))
            {
                updatedDevice.SerialNumber = updatedDevice.SerialNumber.Trim().ToUpper();
            }

            var success = await DeviceService.UpdateDeviceAsync(device.Id, updatedDevice);
            if (success)
            {
                Snackbar.Add("Cập nhật thiết bị thành công!", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Cập nhật thiết bị thất bại (S/N đã tồn tại hoặc lỗi máy chủ)!", Severity.Error);
            }
        }
    }

    private async Task ConfirmDeleteDevice(DeviceDto device)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Cảnh báo",
            $"Bạn có chắc chắn muốn xóa thiết bị với số S/N: {device.SerialNumber ?? "Không có S/N"}?",
            yesText: "Xóa", cancelText: "Hủy");

        if (confirm == true)
        {
            var success = await DeviceService.DeleteDeviceAsync(device.Id);
            if (success)
            {
                Snackbar.Add("Xóa thiết bị thành công!", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Xóa thiết bị thất bại!", Severity.Error);
            }
        }
    }
}
