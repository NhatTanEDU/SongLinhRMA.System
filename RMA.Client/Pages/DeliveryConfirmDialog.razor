@using RMA.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (Order != null)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-4">Mã Đơn: @Order.OrderCode - Khách: @Order.CustomerName</MudText>
            
            @foreach (var detail in Order.Details)
            {
                <MudCard Elevation="0" Outlined="true" Class="mb-4 pa-3">
                    <MudText Typo="Typo.subtitle2">@detail.ModelName (SL: @detail.Quantity)</MudText>
                    
                    @if (detail.IsSerialRequired)
                    {
                        <div class="mt-2">
                            @for (int i = 0; i < detail.Quantity; i++)
                            {
                                var index = i;
                                <MudTextField @bind-Value="serialNumbers[detail.ModelId][index]" 
                                              Label="@($"Serial Number {index + 1}")" 
                                              Variant="Variant.Outlined" 
                                              Margin="Margin.Dense"
                                              Class="mb-2" />
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Success">Không yêu cầu quét Serial (Hệ thống sẽ tự sinh S/N ảo)</MudText>
                    }
                </MudCard>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm" Disabled="@(!IsFormValid())">Xác Nhận Giao Hàng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public SalesOrderDto Order { get; set; } = null!;

    private Dictionary<string, string[]> serialNumbers = new();

    protected override void OnInitialized()
    {
        if (Order != null)
        {
            foreach (var detail in Order.Details)
            {
                if (detail.IsSerialRequired)
                {
                    serialNumbers[detail.ModelId] = new string[detail.Quantity];
                }
            }
        }
    }

    private bool IsFormValid()
    {
        if (Order == null) return false;

        foreach (var detail in Order.Details)
        {
            if (detail.IsSerialRequired)
            {
                var snList = serialNumbers[detail.ModelId];
                if (snList.Any(string.IsNullOrWhiteSpace))
                {
                    return false;
                }
            }
        }
        return true;
    }

    private async Task Confirm()
    {
        var dto = new ConfirmDeliveryDto
        {
            OrderId = Order.Id,
            SerialNumbersByModel = new Dictionary<string, List<string>>()
        };

        foreach (var detail in Order.Details)
        {
            if (detail.IsSerialRequired)
            {
                dto.SerialNumbersByModel[detail.ModelId] = serialNumbers[detail.ModelId].ToList();
            }
            else
            {
                dto.SerialNumbersByModel[detail.ModelId] = new List<string>();
            }
        }

        var response = await Http.PostAsJsonAsync("api/salesorders/confirm-delivery", dto);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Giao hàng thành công!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Lỗi: {error}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
