# Cấu hình môi trường cho RMA.Server (Docker Compose)
# Sao chép file này thành .env và điền các giá trị phù hợp với hệ thống của bạn.

# Cổng chạy ứng dụng trên máy host
PORT=8080

# Môi trường chạy ứng dụng (Development hoặc Production)
ASPNETCORE_ENVIRONMENT=Production

# Đường dẫn vật lý đến file serviceAccountKey.json của Firebase trên máy host
# Ví dụ trên Synology NAS: /volume1/docker/songlinhrma/config/firebase.json
# Ví dụ trên VPS Linux: /home/user/docker/songlinhrma/config/firebase.json
FIREBASE_CREDENTIALS_HOST_PATH=./RMA.Server/serviceAccountKey.json

# Đường dẫn ảo bên trong container mà ứng dụng .NET sẽ đọc
# (Nên giữ nguyên giá trị mặc định này)
GOOGLE_APPLICATION_CREDENTIALS=/app/config/firebase.json

# Đường dẫn lưu trữ logs ngoài máy host
# Ví dụ trên Synology NAS: /volume1/docker/songlinhrma/logs
LOGS_HOST_PATH=./logs
