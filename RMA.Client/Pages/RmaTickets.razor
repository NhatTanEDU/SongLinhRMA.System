@page "/tickets"
@inject RMA.Client.Services.IRmaTicketService TicketService
@inject RMA.Client.Services.CustomerService CustomerService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h3" GutterBottom="true">Quản lý RMA Tickets</MudText>

<MudTable Items="@tickets" Dense="false" Hover="true" Striped="false" Outlined="true" Elevation="2" Class="rounded-lg" Breakpoint="Breakpoint.Sm" Filter="new Func<RmaTicketDto,bool>(FilterFunc)" @bind-SelectedItem="selectedItem">
    <ToolBarContent>
        <MudText Typo="Typo.h6" Class="fw-bold">Danh sách RMA Tickets</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog" Class="ml-4 rounded-lg" StartIcon="@Icons.Material.Filled.Add">Tạo Ticket</MudButton>
        <MudSelect T="bool" Label="Thứ tự thời gian" Value="@_sortByNewest" ValueChanged="OnSortOrderChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="ml-4" Style="width: 155px; max-width: 155px; margin-top: 0;">
            <MudSelectItem Value="true">Gần đây (Mới)</MudSelectItem>
            <MudSelectItem Value="false">Cũ nhất (Cũ)</MudSelectItem>
        </MudSelect>
        <MudSelect T="DateTime?" Label="Lọc theo tháng" Value="@_selectedMonth" ValueChanged="OnMonthChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="ml-4" Style="width: 165px; max-width: 165px; margin-top: 0;">
            <MudSelectItem Value="@((DateTime?)null)">Tất cả các tháng</MudSelectItem>
            @foreach (var m in _availableMonths)
            {
                <MudSelectItem Value="@((DateTime?)m)">@($"Tháng {m.ToString("MM/yyyy")}")</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" Label="Lọc khách hàng" Value="@_selectedCustomerId" ValueChanged="OnCustomerFilterChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="ml-4" Style="width: 200px; max-width: 200px; margin-top: 0;">
            <MudSelectItem Value="@((string)null!)">Tất cả khách hàng</MudSelectItem>
            @foreach (var c in _availableCustomers)
            {
                <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
            }
        </MudSelect>
        @if (!string.IsNullOrEmpty(ColorFilter) || UrgentFilter == true || _selectedMonth.HasValue || !string.IsNullOrEmpty(_selectedCustomerId))
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearFilters" Class="ml-4 rounded-lg">
                ❌ Xóa bộ lọc (@(GetActiveFilterText()))
            </MudButton>
        }
        <MudSpacer />
        <MudTextField @bind-Value="searchString" Immediate="true" Placeholder="Tìm theo Khách hàng, S/N..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Margin="Margin.Dense" Variant="Variant.Outlined"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">STT</MudText></MudTh>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Khách hàng</MudText></MudTh>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Thiết bị</MudText></MudTh>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Hãng</MudText></MudTh>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Mô tả lỗi</MudText></MudTh>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Trạng thái</MudText></MudTh>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Hạn BH</MudText></MudTh>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Ngày nhận</MudText></MudTh>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Cảnh báo SLA</MudText></MudTh>
        <MudTh Style="text-align: right"><MudText Typo="Typo.subtitle2" Class="fw-bold">Thao tác</MudText></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="STT">@(tickets.IndexOf(context) + 1)</MudTd>
        <MudTd DataLabel="Khách hàng">
            <div class="d-flex align-center gap-3">
                @if (!string.IsNullOrEmpty(context.CustomerAvatarUrl))
                {
                    <MudAvatar Size="Size.Medium" Class="elevation-1">
                        <img src="@context.CustomerAvatarUrl" style="width:100%; height:100%; object-fit:cover;" />
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Color="Color.Primary" Size="Size.Medium" Variant="Variant.Filled" Class="elevation-1">
                        @(!string.IsNullOrEmpty(context.CustomerName) ? context.CustomerName.Substring(0, 1).ToUpper() : "?")
                    </MudAvatar>
                }
                <div>
                    <MudLink Color="Color.Inherit" Underline="Underline.Hover" OnClick="@(() => OnCustomerClick(context.CustomerId))">
                        <MudText Typo="Typo.body2" Class="fw-bold">@context.CustomerName</MudText>
                    </MudLink>
                    @if(!string.IsNullOrEmpty(context.CustomerContactPerson)){
                        <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:600;">
                            <MudIcon Icon="@Icons.Material.Filled.PersonPin" Size="Size.Small" Style="font-size:0.85rem;vertical-align:middle;" /> ĐD: @context.CustomerContactPerson
                        </MudText>
                    }
                    @if(!string.IsNullOrEmpty(context.CustomerPhone)){
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CustomerPhone</MudText>
                    }
                    @if(!string.IsNullOrEmpty(context.EndUserName)){
                        <MudText Typo="Typo.caption" Style="color:#e65100;">
                            👤 @context.EndUserName
                        </MudText>
                    }
                </div>
            </div>
        </MudTd>
        <MudTd DataLabel="Thiết bị">
            <MudText Typo="Typo.body2" Class="fw-bold">@context.DeviceModelName</MudText>
            <MudLink Color="Color.Secondary" Typo="Typo.caption" Underline="Underline.Hover" OnClick="@(() => OnSerialNumberClick(context.DeviceSerialNumber))">
                SN: @context.DeviceSerialNumber
            </MudLink>
        </MudTd>
        <MudTd DataLabel="Hãng">@context.VendorName</MudTd>
        <MudTd DataLabel="Mô tả lỗi">
            <MudTooltip Text="@context.ProblemDescription">
                <div style="max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    @context.ProblemDescription
                </div>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Trạng thái">
            <div class="d-flex align-center gap-2">
                <MudSelect T="string" Value="@context.StatusId" ValueChanged="@((newId) => OnQuickStatusChanged(context, newId))" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 140px; margin-top: 0;">
                    @foreach (var s in _statuses)
                    {
                        <MudSelectItem Value="@s.Id">@s.StatusName</MudSelectItem>
                    }
                </MudSelect>
                @if(context.IsUrgent) {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">Gấp</MudChip>
                }
            </div>
        </MudTd>
        <MudTd DataLabel="Hạn BH">
            @if (context.DeviceWarrantyExpiry.HasValue)
            {
                var isActive = context.DeviceWarrantyExpiry.Value > DateTime.Now;
                <MudTooltip Text="@($"Hạn BH: {context.DeviceWarrantyExpiry.Value:dd/MM/yyyy}")">
                    <MudChip T="string"
                             Color="@(isActive ? Color.Success : Color.Error)"
                             Size="Size.Small"
                             Icon="@(isActive ? Icons.Material.Filled.Verified : Icons.Material.Filled.GppBad)"
                             Variant="Variant.Filled">
                        @(isActive ? "Còn BH" : "Hết BH")
                    </MudChip>
                </MudTooltip>
            }
            else
            {
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">N/A</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Ngày nhận">
            <MudText Typo="Typo.body2">N: @context.ReceivedDate.ToString("dd/MM/yyyy")</MudText>
            @if(context.SentDate.HasValue){
                <MudText Typo="Typo.caption" Color="Color.Secondary">G: @context.SentDate.Value.ToString("dd/MM/yyyy")</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Cảnh báo SLA">
            @if (context.StatusName == "Closed")
            {
                <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small">
                    Đã hoàn tất
                </MudChip>
            }
            else if (context.WarningColor == "Red")
            {
                <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Warning" Size="Size.Small">
                    Quá hạn (>= 14 ngày)
                </MudChip>
            }
            else if (context.WarningColor == "Yellow")
            {
                <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.Schedule" Size="Size.Small">
                    Sắp trễ hạn (10-13 ngày)
                </MudChip>
            }
            else if (context.WarningColor == "Green")
            {
                <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small">
                    An toàn
                </MudChip>
            }
            else 
            {
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                    Chưa gửi đi
                </MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Thao tác" Style="text-align: right; white-space: nowrap;">
            <MudTooltip Text="Xem chi tiết">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenDetailDialog(context))" />
            </MudTooltip>
            <MudTooltip Text="Chỉnh sửa">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenEditDialog(context))" />
            </MudTooltip>
            <MudTooltip Text="Xóa">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteTicket(context.Id))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    [SupplyParameterFromQuery]
    public string? ColorFilter { get; set; }

    [SupplyParameterFromQuery]
    public bool? UrgentFilter { get; set; }

    private List<RmaTicketDto> tickets = new List<RmaTicketDto>();
    private List<RmaTicketDto> allTickets = new List<RmaTicketDto>();
    private string searchString = "";
    private RmaTicketDto? selectedItem = null;
    private List<StatusMasterDto> _statuses = new();
    private DateTime? _selectedMonth;
    private bool _sortByNewest = true;
    private List<DateTime> _availableMonths = new();
    private string? _selectedCustomerId;
    private List<CustomerDto> _availableCustomers = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override void OnParametersSet()
    {
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = allTickets.AsEnumerable();
        if (!string.IsNullOrEmpty(ColorFilter))
        {
            query = query.Where(t => t.WarningColor != null && t.WarningColor.Equals(ColorFilter, StringComparison.OrdinalIgnoreCase));
        }
        if (UrgentFilter == true)
        {
            query = query.Where(t => t.IsUrgent);
        }
        if (_selectedMonth.HasValue)
        {
            query = query.Where(t => t.ReceivedDate.Month == _selectedMonth.Value.Month && t.ReceivedDate.Year == _selectedMonth.Value.Year);
        }
        if (!string.IsNullOrEmpty(_selectedCustomerId))
        {
            query = query.Where(t => t.CustomerId == _selectedCustomerId);
        }
        
        query = _sortByNewest 
            ? query.OrderByDescending(t => t.ReceivedDate) 
            : query.OrderBy(t => t.ReceivedDate);

        tickets = query.ToList();
    }

    private string GetColorFilterTranslation(string? color)
    {
        return color?.ToLower() switch
        {
            "red" => "Quá hạn",
            "yellow" => "Sắp trễ hạn",
            "green" => "Đúng hạn",
            _ => color ?? ""
        };
    }

    private void ClearFilters()
    {
        _selectedMonth = null;
        _selectedCustomerId = null;
        NavigationManager.NavigateTo("/tickets");
    }

    private void OnMonthChanged(DateTime? newDate)
    {
        _selectedMonth = newDate;
        ApplyFilters();
    }

    private void OnSortOrderChanged(bool sortByNewest)
    {
        _sortByNewest = sortByNewest;
        ApplyFilters();
    }

    private void OnCustomerFilterChanged(string? customerId)
    {
        _selectedCustomerId = customerId;
        ApplyFilters();
    }

    private void OnCustomerClick(string customerId)
    {
        _selectedCustomerId = customerId;
        ApplyFilters();
    }

    private void OnSerialNumberClick(string serialNumber)
    {
        searchString = serialNumber;
        StateHasChanged();
    }

    private string GetActiveFilterText()
    {
        var parts = new List<string>();
        if (UrgentFilter == true) parts.Add("GẤP");
        if (!string.IsNullOrEmpty(ColorFilter)) parts.Add(GetColorFilterTranslation(ColorFilter));
        if (_selectedMonth.HasValue) parts.Add($"Tháng {_selectedMonth.Value.ToString("MM/yyyy")}");
        if (!string.IsNullOrEmpty(_selectedCustomerId))
        {
            var custName = _availableCustomers.FirstOrDefault(c => c.Id == _selectedCustomerId)?.Name ?? "Khách hàng";
            parts.Add(custName);
        }
        return string.Join(" + ", parts);
    }

    private async Task LoadData()
    {
        var ticketsTask = TicketService.GetRmaTicketsAsync();
        var statusesTask = TicketService.GetStatusesAsync();
        var customersTask = CustomerService.GetCustomersAsync();
        await Task.WhenAll(ticketsTask, statusesTask, customersTask);
        
        allTickets = ticketsTask.Result;
        _statuses = statusesTask.Result;
        _availableCustomers = customersTask.Result.OrderBy(c => c.Name).ToList();

        _availableMonths = allTickets
            .Select(t => new DateTime(t.ReceivedDate.Year, t.ReceivedDate.Month, 1))
            .Distinct()
            .OrderByDescending(d => d)
            .ToList();

        ApplyFilters();
    }

    private async Task OnQuickStatusChanged(RmaTicketDto ticket, string newStatusId)
    {
        if (ticket.StatusId == newStatusId) return;

        var oldStatusId = ticket.StatusId;
        var oldStatusName = ticket.StatusName;
        var oldStatusColor = ticket.StatusColorCode;
        var oldWarningColor = ticket.WarningColor;
        var oldIsUrgent = ticket.IsUrgent;

        var newStatus = _statuses.FirstOrDefault(s => s.Id == newStatusId);
        if (newStatus == null) return;

        // Optimistic UI update
        ticket.StatusId = newStatusId;
        ticket.StatusName = newStatus.StatusName;
        ticket.StatusColorCode = newStatus.ColorCode;
        if (newStatus.StatusName.Equals("Closed", StringComparison.OrdinalIgnoreCase))
        {
            ticket.WarningColor = null;
            ticket.IsUrgent = false;
        }
        StateHasChanged();

        var success = await TicketService.UpdateRmaTicketAsync(ticket.Id, ticket);
        if (success)
        {
            Snackbar.Add($"Đã cập nhật trạng thái thành công sang '{newStatus.StatusName}'!", Severity.Success);
        }
        else
        {
            // Rollback UI update
            ticket.StatusId = oldStatusId;
            ticket.StatusName = oldStatusName;
            ticket.StatusColorCode = oldStatusColor;
            ticket.WarningColor = oldWarningColor;
            ticket.IsUrgent = oldIsUrgent;
            StateHasChanged();
            Snackbar.Add("Có lỗi xảy ra khi cập nhật trạng thái.", Severity.Error);
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var parameters = new DialogParameters
        {
            ["Ticket"] = new RmaTicketDto(),
            ["OnTicketCreated"] = EventCallback.Factory.Create(this, LoadData)
        };

        var dialog = await DialogService.ShowAsync<RmaTicketDialog>("Tạo RMA Ticket Mới", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is RmaTicketDto newTicket)
        {
            var created = await TicketService.CreateRmaTicketAsync(newTicket);
            if (created != null)
            {
                Snackbar.Add("Tạo RMA Ticket thành công!", Severity.Success);
                await LoadData();
            }
        }
    }

    private async Task OpenEditDialog(RmaTicketDto ticket)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        
        // Deep copy of DTO
        var ticketCopy = new RmaTicketDto
        {
            Id = ticket.Id,
            DeviceId = ticket.DeviceId,
            DeviceSerialNumber = ticket.DeviceSerialNumber,
            DeviceModelName = ticket.DeviceModelName,
            CustomerId = ticket.CustomerId,
            CustomerName = ticket.CustomerName,
            CustomerPhone = ticket.CustomerPhone,
            CustomerContactPerson = ticket.CustomerContactPerson,
            StatusId = ticket.StatusId,
            StatusName = ticket.StatusName,
            StatusColorCode = ticket.StatusColorCode,
            WarningColor = ticket.WarningColor,
            VendorId = ticket.VendorId,
            VendorName = ticket.VendorName,
            VendorWarrantyLink = ticket.VendorWarrantyLink,
            DeviceWarrantyExpiry = ticket.DeviceWarrantyExpiry,
            ProblemDescription = ticket.ProblemDescription,
            ServiceMode = ticket.ServiceMode,
            ReceivedDate = ticket.ReceivedDate,
            SentDate = ticket.SentDate,
            IsUrgent = ticket.IsUrgent,
            StaffNote = ticket.StaffNote,
            EndUserName = ticket.EndUserName
        };

        var parameters = new DialogParameters
        {
            ["Ticket"] = ticketCopy
        };

        var dialog = await DialogService.ShowAsync<RmaTicketDialog>("Cập nhật RMA Ticket", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is RmaTicketDto updatedTicket)
        {
            var success = await TicketService.UpdateRmaTicketAsync(updatedTicket.Id, updatedTicket);
            if (success)
            {
                Snackbar.Add("Cập nhật RMA Ticket thành công!", Severity.Success);
                await LoadData();
            }
        }
    }

    private async Task OpenDetailDialog(RmaTicketDto ticket)
    {
        // Deep copy để tránh binding trực tiếp làm thay đổi grid khi chưa bấm Lưu
        var ticketCopy = new RmaTicketDto
        {
            Id = ticket.Id,
            DeviceId = ticket.DeviceId,
            DeviceSerialNumber = ticket.DeviceSerialNumber,
            DeviceModelName = ticket.DeviceModelName,
            CustomerId = ticket.CustomerId,
            CustomerName = ticket.CustomerName,
            CustomerPhone = ticket.CustomerPhone,
            CustomerContactPerson = ticket.CustomerContactPerson,
            StatusId = ticket.StatusId,
            StatusName = ticket.StatusName,
            StatusColorCode = ticket.StatusColorCode,
            WarningColor = ticket.WarningColor,
            VendorId = ticket.VendorId,
            VendorName = ticket.VendorName,
            VendorWarrantyLink = ticket.VendorWarrantyLink,
            DeviceWarrantyExpiry = ticket.DeviceWarrantyExpiry,
            ProblemDescription = ticket.ProblemDescription,
            ServiceMode = ticket.ServiceMode,
            ReceivedDate = ticket.ReceivedDate,
            SentDate = ticket.SentDate,
            IsUrgent = ticket.IsUrgent,
            StaffNote = ticket.StaffNote,
            EndUserName = ticket.EndUserName,
            Attachments = ticket.Attachments,
            Checklists = ticket.Checklists,
            StatusHistories = ticket.StatusHistories
        };

        var parameters = new DialogParameters 
        { 
            ["Ticket"] = ticketCopy,
            ["OnTicketUpdated"] = EventCallback.Factory.Create<RmaTicketDto>(this, async (updatedTicket) => { await LoadData(); })
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RmaTicketDetailDialog>("Chi tiết Phiếu RMA", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is RmaTicketDto updatedTicket)
        {
            // Cập nhật tại chỗ (In-place) không fetch lại API
            var index = tickets.FindIndex(t => t.Id == updatedTicket.Id);
            if (index != -1)
            {
                tickets[index] = updatedTicket;
            }
            var allIndex = allTickets.FindIndex(t => t.Id == updatedTicket.Id);
            if (allIndex != -1)
            {
                allTickets[allIndex] = updatedTicket;
            }
            StateHasChanged();
        }
    }

    private async Task DeleteTicket(string id)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Xác nhận xóa", 
            "Bạn có chắc chắn muốn xóa Ticket này không?", 
            yesText: "Xóa", cancelText: "Hủy");

        if (confirm == true)
        {
            var success = await TicketService.DeleteRmaTicketAsync(id);
            if (success)
            {
                Snackbar.Add("Xóa RMA Ticket thành công!", Severity.Success);
                await LoadData();
            }
        }
    }

    private bool FilterFunc(RmaTicketDto element)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.CustomerName != null && element.CustomerName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.DeviceSerialNumber != null && element.DeviceSerialNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.StatusName != null && element.StatusName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.EndUserName != null && element.EndUserName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.CustomerContactPerson != null && element.CustomerContactPerson.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private Color GetStatusColor(string statusName)
    {
        return statusName switch
        {
            "New" => Color.Info,
            "In Progress" => Color.Warning,
            "Waiting for Parts" => Color.Error,
            "Repaired" => Color.Success,
            "Closed" => Color.Default,
            _ => Color.Default
        };
    }
}
