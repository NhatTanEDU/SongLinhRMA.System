    private async Task SaveDevice()
    {
        if (string.IsNullOrWhiteSpace(_newDeviceModelId) || string.IsNullOrWhiteSpace(_newDeviceCustomerId))
        {
            Snackbar.Add("Vui lòng chọn Model và Khách hàng sở hữu!", Severity.Warning);
            return;
        }

        _savingNewDevice = true;
        StateHasChanged();

        try
        {
            var dto = new DeviceCreateDto
            {
                CustomerId   = _newDeviceCustomerId,
                ModelId      = _newDeviceModelId,
                SerialNumber = _searchSerialNumber.Trim().ToUpper().Replace(" ", ""),
                PurchaseDate = DateTime.UtcNow
            };
            var added = await DeviceService.CreateDeviceAsync(dto);
            if (added != null)
            {
                Snackbar.Add($"✅ Đã tạo thiết bị S/N: {added.SerialNumber}", Severity.Success);
                _deviceNotFound = false;
                
                // Kích hoạt tra cứu tự động lại
                await LookupDevice();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi lưu thiết bị: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingNewDevice = false;
            StateHasChanged();
        }
    }

    private async Task UploadImageForOcr(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        _ocrScanning = true;
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10485760).CopyToAsync(ms);
            var buffer = ms.ToArray();
            var base64 = Convert.ToBase64String(buffer);

            var response = await Http.PostAsJsonAsync("api/ocr/scan", new OcrRequestDto { Base64Image = base64 });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OcrResponseDto>();
                if (result != null && !string.IsNullOrEmpty(result.SerialNumber))
                {
                    _searchSerialNumber = result.SerialNumber;
                    Snackbar.Add($"✅ OCR thành công! S/N: {_searchSerialNumber}", Severity.Success);
                    await LookupDevice();
                }
                else
                {
                    Snackbar.Add("Không nhận diện được Serial Number từ ảnh.", Severity.Warning);
                }
            }
            else
            {
                string errorMsg = "Lỗi khi gọi API OCR.";
                try
                {
                    var errorObj = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                    if (errorObj != null && errorObj.TryGetValue("message", out var msg))
                    {
                        errorMsg = msg;
                    }
                }
                catch { }
                Snackbar.Add(errorMsg, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _ocrScanning = false;
            StateHasChanged();
        }
    }

    private void ToggleAcc(string acc)
    {
        if (_selectedAcc.Contains(acc)) _selectedAcc.Remove(acc);
        else _selectedAcc.Add(acc);
    }

    private void AddCustomAcc()
    {
        if (!string.IsNullOrWhiteSpace(_customAcc))
        {
            var t = _customAcc.Trim();
            if (!_accessories.Contains(t)) _accessories.Add(t);
            if (!_selectedAcc.Contains(t)) _selectedAcc.Add(t);
            _customAcc = "";
        }
    }

    private async Task OnFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        if (files == null || !files.Any()) return;
        _uploading = true;
        StateHasChanged();

        foreach (var file in files)
        {
            if (file.Size > 5 * 1024 * 1024)
            {
                Snackbar.Add($"File {file.Name} vượt quá giới hạn 5MB!", Severity.Warning);
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());

                Ticket.Attachments.Add(new AttachmentDto
                {
                    FileName = file.Name,
                    Base64Data = base64,
                    FileType = file.Name.Contains("serial", StringComparison.OrdinalIgnoreCase) || file.Name.Contains("sn", StringComparison.OrdinalIgnoreCase)
                        ? "SN_PHOTO"
                        : "CONDITION_PHOTO",
                    UploadedAt = DateTime.UtcNow
                });
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi khi tải ảnh {file.Name}: {ex.Message}", Severity.Error);
            }
        }

        _uploading = false;
        StateHasChanged();
    }

    private void RemoveAttachment(AttachmentDto att)
    {
        Ticket.Attachments.Remove(att);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _submitting = true;
        StateHasChanged();

        try
        {
            // Build StaffNote with accessories checklist and logistics metadata
            var accStr = _selectedAcc.Any() ? string.Join(", ", _selectedAcc) : "Không có";
            var bh = (CurrentDevice?.WarrantyExpiry.HasValue == true && CurrentDevice.WarrantyExpiry.Value.ToLocalTime() >= DateTime.Now) ? "Còn BH" : "Hết BH";
            var meta = $"[Vị trí: {_location}] [BH: {bh}] [Phụ kiện: {accStr}]";

            var originalStaffNote = Ticket.StaffNote;
            Ticket.StaffNote = string.IsNullOrWhiteSpace(originalStaffNote)
                ? meta
                : $"{meta}\n{originalStaffNote}";

            // For new ticket, set initial SentDate to today
            if (string.IsNullOrEmpty(Ticket.Id))
            {
                Ticket.SentDate = DateTime.UtcNow;
                // Auto-Bind ngầm ID thiết bị/khách hàng từ CurrentDevice
                if (CurrentDevice != null)
                {
                    Ticket.DeviceId = CurrentDevice.DeviceId;
                    Ticket.CustomerId = CurrentDevice.CustomerId;
                }
                // Ẩn/Bỏ chọn Trạng thái, tự động gán rỗng để Backend tự gán cứng TicketStatus.New
                Ticket.StatusId = string.Empty;
            }

            if (_keepFormOpen && string.IsNullOrEmpty(Ticket.Id))
            {
                var created = await TicketService.CreateRmaTicketAsync(Ticket);
                Ticket.StaffNote = originalStaffNote;

                if (created != null)
                {
                    Snackbar.Add($"✅ Đã tạo Ticket thành công cho S/N: {created.DeviceSerialNumber}!", Severity.Success);
                    
                    if (OnTicketCreated.HasDelegate)
                    {
                        await OnTicketCreated.InvokeAsync();
                    }

                    // Reset form fields
                    _searchSerialNumber = "";
                    CurrentDevice = null;
                    Ticket.DeviceId = "";
                    Ticket.DeviceSerialNumber = "";
                    Ticket.DeviceModelName = "";
                    Ticket.Attachments.Clear();
                    _selectedAcc.Clear();
                    Ticket.ProblemDescription = "";
                    Ticket.EndUserName = "";
                    Ticket.StaffNote = "";

                    await _form.ResetValidationAsync();
                }
                else
                {
                    Snackbar.Add("Thêm Phiếu RMA thất bại!", Severity.Error);
                }
            }
            else
            {
                if (string.IsNullOrEmpty(Ticket.Id))
                {
                    // Create mode without keep form open
                    var created = await TicketService.CreateRmaTicketAsync(Ticket);
                    Ticket.StaffNote = originalStaffNote;
                    if (created != null)
                    {
                        Snackbar.Add($"✅ Đã tạo Ticket thành công cho S/N: {created.DeviceSerialNumber}!", Severity.Success);
                        MudDialog.Close(DialogResult.Ok(created));
                    }
                    else
                    {
                        Snackbar.Add("Thêm Phiếu RMA thất bại!", Severity.Error);
                    }
                }
                else
                {
                    // Edit mode
                    Ticket.StaffNote = originalStaffNote;
                    MudDialog.Close(DialogResult.Ok(Ticket));
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    private Color GetStatusColor(TicketStatus status)
    {
        return status switch
        {
            TicketStatus.New => Color.Info,
            TicketStatus.Diagnosing => Color.Warning,
            TicketStatus.WaitingApproval => Color.Warning,
            TicketStatus.WaitingParts => Color.Error,
            TicketStatus.Repairing => Color.Primary,
            TicketStatus.WaitingVendor => Color.Secondary,
            TicketStatus.Completed => Color.Success,
            TicketStatus.Closed => Color.Dark,
            _ => Color.Default
        };
    }
